BCF_BASE_URL=https://api.blockchainfue.com/api
BCF_APP_ID=
BCF_APP_KEY=
BCF_NETWORK=test
PORT=8080
APP_ENV=development
# Periodicidad del chequeo de pagarés vencidos/prescritos (formato time.Duration de Go, p.ej. 24h, 6h, 30m)
CRON_INTERVAL=24h
# Clave maestra para cifrar las claves privadas de usuario en la BBDD (AES-256-GCM).
# 32 bytes en hex (64 chars) o base64. OBLIGATORIA en producción; en desarrollo
# se usa una clave insegura por defecto si se deja vacía.
# Generar una: openssl rand -hex 32
KEYS_MASTER_KEY=

# Quien expide y firma los certificados de registro y verificación.
CERT_NOMBRE=Nombre y apellidos
CERT_CARGO=Director
CERT_ENTIDAD=BlockchainFUE

# --- Logalty: servicio web (WsDataChannel) ----------------------------------
LOGALTY_ENDPOINT=
LOGALTY_USER=
LOGALTY_PASSWORD=

# --- Logalty: empresa emisora ----------------------------------------------
# COMPANY y TYPE identifican la empresa emisora y el tipo de envío configurado
# para ella. El tipo 31210 exige que el receptor tenga número de móvil.
LOGALTY_COMPANY=
LOGALTY_TYPE=

# --- Logalty: portal (web UI) ----------------------------------------------
# Aplicación de página única; sus pantallas son rutas hash sobre esta base,
# p.ej. #/login, #/shippings, #/administration/samlcertificates.
LOGALTY_PORTAL=

# --- Logalty: tipo de envío de contratación, con el que se firman los PDFs ---
# Es necesariamente otro tipo que el de validación de identidad: el envío
# síncrono —el único que devuelve la URL de firma en el acto— sólo acepta tipos
# de contratación y rechaza los demás con el código 122.
LOGALTY_TYPE_CONTRACT=
