BCF_BASE_URL=https://api.blockchainfue.com/api
BCF_APP_ID=
BCF_APP_KEY=
BCF_NETWORK=test
PORT=8080
APP_ENV=development
# Periodicidad del chequeo de pagarés vencidos/prescritos (formato time.Duration de Go, p.ej. 24h, 6h, 30m)
CRON_INTERVAL=24h
# Clave maestra para cifrar las claves privadas de usuario en la BBDD (AES-256-GCM).
# 32 bytes en hex (64 chars) o base64. OBLIGATORIA en producción; en desarrollo
# se usa una clave insegura por defecto si se deja vacía.
# Generar una: openssl rand -hex 32
KEYS_MASTER_KEY=
