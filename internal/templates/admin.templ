package templates

templ Admin(user *CurrentUser) {
	@Base("Administración", user) {
		@PageHead("Administración", "Panel de administración", "Gestión de usuarios de la plataforma y claves de la aplicación.")

		<style>
			.admin-tabs { display:flex; gap:4px; border-bottom:1px solid var(--border); margin-bottom:24px; }
			.admin-tab { background:none; border:none; padding:10px 16px; font-family:var(--sans); font-size:0.92rem; font-weight:600; color:var(--ink-soft); cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-1px; }
			.admin-tab:hover { color:var(--ink); }
			.admin-tab.active { color:var(--ink); border-bottom-color:var(--gold-deep); }

			.utable-wrap { overflow-x:auto; }
			.utable { width:100%; border-collapse:collapse; font-size:0.9rem; }
			.utable th { text-align:left; font-size:0.7rem; text-transform:uppercase; letter-spacing:0.04em; color:var(--ink-soft); font-weight:700; padding:10px 12px; border-bottom:1px solid var(--border); white-space:nowrap; }
			.utable td { padding:12px; border-bottom:1px solid var(--border); vertical-align:middle; }
			.utable tr:last-child td { border-bottom:none; }
			.utable tbody tr:hover td { background:var(--paper-2); }
			.u-name { font-weight:600; color:var(--ink); }
			.u-sub { font-size:0.8rem; color:var(--ink-soft); }
			.u-mono { font-family:ui-monospace,'SF Mono',Menlo,monospace; font-size:0.82rem; }
			.role-badge { display:inline-block; padding:2px 9px; font-size:0.72rem; font-weight:700; border-radius:999px; border:1px solid transparent; }
			.role-admin { background:var(--gold-bg); color:var(--gold-deep); border-color:#E6D4A0; }
			.role-user { background:var(--paper-2); color:var(--ink-soft); border-color:var(--border-2); }
			.u-actions { display:flex; gap:6px; justify-content:flex-end; white-space:nowrap; }
			.btn-xs { padding:5px 11px; font-size:0.78rem; }
			.u-toolbar { display:flex; gap:12px; align-items:center; justify-content:space-between; margin-bottom:16px; flex-wrap:wrap; }
			.u-search { flex:1; min-width:200px; max-width:340px; margin:0; }
			.u-search input { margin:0; }
			.u-count { font-size:0.82rem; color:var(--ink-soft); }

			.modal-overlay { position:fixed; inset:0; background:rgba(27,42,74,0.45); display:none; align-items:flex-start; justify-content:center; padding:5vh 16px; z-index:1000; overflow-y:auto; }
			.modal-overlay.open { display:flex; }
			.modal { background:var(--card); border-radius:var(--r); box-shadow:var(--shadow-lg); width:100%; max-width:660px; padding:28px 30px; }
			.modal-head { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; margin-bottom:20px; }
			.modal-head h2 { font-family:var(--serif); font-size:1.4rem; font-weight:600; color:var(--ink); margin:0; }
			.modal-close { background:none; border:none; font-size:1.6rem; line-height:1; color:var(--ink-soft); cursor:pointer; padding:0 4px; }
			.modal-close:hover { color:var(--ink); }
			.modal-section { border-top:1px solid var(--border); margin-top:22px; padding-top:18px; }
			.modal-section h3 { font-size:0.78rem; text-transform:uppercase; letter-spacing:0.04em; color:var(--ink-soft); font-weight:700; margin:0 0 14px; }
			.pk-row { display:flex; align-items:center; gap:8px; margin-bottom:6px; }
			.pk-row .u-mono { flex:1; word-break:break-all; }
			.pk-del { background:none; border:none; color:var(--danger); cursor:pointer; font-size:1.1rem; line-height:1; padding:0 4px; }
		</style>

		<div class="admin-tabs">
			<button type="button" class="admin-tab" data-tab="usuarios" onclick="showAdminTab('usuarios')">Usuarios</button>
			<button type="button" class="admin-tab" data-tab="clave-app" onclick="showAdminTab('clave-app')">Clave de aplicación</button>
		</div>

		<!-- Panel: Usuarios -->
		<div id="tab-usuarios" class="admin-panel">
			<div class="card">
				<div class="flex-between" style="margin-bottom:18px;">
					<div>
						<h2 class="card-title" style="margin-bottom:2px;">Usuarios de la plataforma</h2>
						<p class="desc" style="margin:0;">Sus datos y claves públicas alimentan los desplegables de los formularios de pagarés.</p>
					</div>
					<button class="btn btn-primary btn-sm" onclick="openCreateModal()">
						@Icon("plus")
						Nuevo usuario
					</button>
				</div>

				<div class="u-toolbar">
					<div class="field u-search">
						<input type="text" id="user-search" placeholder="Buscar por usuario, nombre o NIF…" oninput="renderUsers()"/>
					</div>
					<span class="u-count" id="user-count"></span>
				</div>

				<div id="users-error" class="alert alert-error hidden" style="margin-bottom:14px;"></div>

				<div class="utable-wrap">
					<table class="utable">
						<thead>
							<tr>
								<th>Usuario</th>
								<th>Nombre completo</th>
								<th>NIF</th>
								<th>Localidad</th>
								<th>Claves</th>
								<th style="text-align:right;">Acciones</th>
							</tr>
						</thead>
						<tbody id="users-tbody">
							<tr><td colspan="6" class="u-sub">Cargando usuarios…</td></tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>

		<!-- Panel: Clave de aplicación -->
		<div id="tab-clave-app" class="admin-panel hidden">
			<div class="card">
				<h2 class="card-title">Clave de la aplicación</h2>
				<p class="desc">Clave principal de la aplicación en BlockchainFUE.</p>
				<button class="btn btn-outline btn-sm" onclick="loadAppKeypair()">
					@Icon("key")
					Obtener keypair
				</button>
				<div id="app-keypair" class="mt-4"></div>
			</div>
		</div>

		<!-- Modal: crear / editar usuario -->
		<div id="user-modal" class="modal-overlay" onclick="if(event.target===this)closeUserModal()">
			<div class="modal">
				<div class="modal-head">
					<h2 id="modal-title">Editar usuario</h2>
					<button type="button" class="modal-close" onclick="closeUserModal()">&times;</button>
				</div>

				<div id="modal-error" class="alert alert-error hidden" style="margin-bottom:14px;"></div>

				<input type="hidden" id="m-id"/>

				<div class="form-grid">
					<div class="field" id="m-username-field">
						<label class="form-label">Usuario (login)</label>
						<input type="text" id="m-username" placeholder="usuario-regular"/>
					</div>
					<div class="field" id="m-password-field">
						<label class="form-label">Contraseña inicial</label>
						<input type="password" id="m-password" placeholder="••••••••"/>
					</div>
					<div class="field">
						<label class="form-label">Rol</label>
						<select id="m-role">
							<option value="user">Usuario regular</option>
							<option value="admin">Administrador</option>
						</select>
					</div>
					<div class="field">
						<label class="form-label">Nombre para mostrar</label>
						<input type="text" id="m-display_name" placeholder="Opcional"/>
					</div>
					<div class="field">
						<label class="form-label">Nombre</label>
						<input type="text" id="m-nombre" placeholder="Juan"/>
					</div>
					<div class="field">
						<label class="form-label">Apellidos</label>
						<input type="text" id="m-apellido" placeholder="Pérez García"/>
					</div>
					<div class="field">
						<label class="form-label">NIF / NIE / CIF</label>
						<input type="text" id="m-nif" placeholder="12345678Z"/>
					</div>
					<div class="field">
						<label class="form-label">Email</label>
						<input type="email" id="m-email" placeholder="usuario@ejemplo.com"/>
					</div>
					<div class="field">
						<label class="form-label">Teléfono</label>
						<input type="tel" id="m-telefono" placeholder="+34 600 000 000"/>
					</div>
					<div class="field">
						<label class="form-label">País (ISO)</label>
						<input type="text" id="m-pais" placeholder="ES"/>
					</div>
					<div class="field" style="grid-column:1/-1;">
						<label class="form-label">Dirección</label>
						<input type="text" id="m-direccion" placeholder="Calle Mayor 10"/>
					</div>
					<div class="field">
						<label class="form-label">Localidad</label>
						<input type="text" id="m-localidad" placeholder="Madrid"/>
					</div>
					<div class="field">
						<label class="form-label">Código Postal</label>
						<input type="text" id="m-codigo_postal" placeholder="28001"/>
					</div>
				</div>

				<div id="m-create-hint" class="alert alert-info" style="margin-top:4px; display:none;">
					@Icon("key")
					Al crear el usuario se generará automáticamente su identidad (par de claves blockchain). La clave privada se guarda cifrada y nunca se muestra.
				</div>

				<div class="flex-between" style="margin-top:6px;">
					<button type="button" class="btn btn-ghost btn-sm" onclick="closeUserModal()">Cancelar</button>
					<button type="button" class="btn btn-primary btn-sm" id="m-save" onclick="saveUser()">Guardar</button>
				</div>

				<!-- Sólo en edición: reset de contraseña y gestión de claves -->
				<div id="m-edit-extra">
					<div class="modal-section">
						<h3>Restablecer contraseña</h3>
						<div class="flex-between" style="gap:10px; align-items:flex-end;">
							<div class="field" style="flex:1; margin:0;">
								<label class="form-label">Nueva contraseña (mín. 6)</label>
								<input type="password" id="m-newpass" placeholder="••••••••"/>
							</div>
							<button type="button" class="btn btn-outline btn-sm" onclick="resetPassword()">Restablecer</button>
						</div>
						<div id="m-pass-result" class="mt-2"></div>
					</div>

					<div class="modal-section">
						<h3>Claves públicas vinculadas</h3>
						<div id="m-pubkeys"></div>
						<div class="flex-between" style="gap:10px; align-items:flex-end; margin-top:10px;">
							<div class="field" style="flex:1; margin:0;">
								<label class="form-label">Añadir clave pública</label>
								<input type="text" id="m-newpub" class="u-mono" placeholder="pub…"/>
							</div>
							<button type="button" class="btn btn-outline btn-sm" onclick="addPubkey()">Añadir</button>
						</div>
					</div>
				</div>
			</div>
		</div>

		<script>
		// ---------- tabs ----------
		function showAdminTab(tab) {
			document.querySelectorAll('.admin-panel').forEach(function(p){ p.classList.add('hidden'); });
			var panel = document.getElementById('tab-' + tab);
			if (panel) panel.classList.remove('hidden');
			document.querySelectorAll('.admin-tab').forEach(function(b){ b.classList.toggle('active', b.getAttribute('data-tab') === tab); });
			if (history.replaceState) history.replaceState(null, '', '#' + tab);
		}
		(function(){
			var h = (location.hash || '#usuarios').replace('#','');
			if (h !== 'usuarios' && h !== 'clave-app') h = 'usuarios';
			showAdminTab(h);
		})();
		window.addEventListener('hashchange', function(){
			var h = (location.hash || '#usuarios').replace('#','');
			if (h === 'usuarios' || h === 'clave-app') showAdminTab(h);
		});

		// ---------- app keypair ----------
		function loadAppKeypair() {
			document.getElementById('app-keypair').innerHTML = '<p class="text-muted">Cargando…</p>';
			fetch('/admin/keypair/application').then(function(r){return r.json();}).then(function(data){
				var el = document.getElementById('app-keypair');
				if (!data.ok) { el.innerHTML = '<div class="alert alert-error">' + data.msg + '</div>'; return; }
				el.innerHTML = keyField('Pub', data.pub) +
					keyField('Pvt (clave privada)', data.pvt) +
					'<div class="key-actions"><button type="button" class="btn btn-sm btn-outline" id="appkp-download">Descargar JSON</button></div>';
				document.getElementById('appkp-download').addEventListener('click', function() {
					downloadJSON('pagare-app-keypair-' + String(data.pub).slice(0, 8) + '.json', {
						type: 'application-keypair', pub: data.pub, pvt: data.pvt, downloaded_at: new Date().toISOString()
					});
				});
			}).catch(function(e){ document.getElementById('app-keypair').innerHTML = '<div class="alert alert-error">Error: ' + e + '</div>'; });
		}

		// ---------- users ----------
		var allUsers = [];

		function esc(s) { return (s == null ? '' : String(s)).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }

		function loadUsers() {
			fetch('/admin/usuarios').then(function(r){return r.json();}).then(function(data){
				var err = document.getElementById('users-error');
				if (!data.ok) { err.textContent = data.msg || 'Error al cargar usuarios'; err.classList.remove('hidden'); return; }
				err.classList.add('hidden');
				allUsers = data.usuarios || [];
				renderUsers();
			}).catch(function(){
				var err = document.getElementById('users-error');
				err.textContent = 'Error de red al cargar usuarios'; err.classList.remove('hidden');
			});
		}

		function renderUsers() {
			var q = (document.getElementById('user-search').value || '').toLowerCase().trim();
			var list = allUsers.filter(function(u){
				if (!q) return true;
				return (u.username||'').toLowerCase().indexOf(q) >= 0 ||
					((u.nombre||'') + ' ' + (u.apellido||'')).toLowerCase().indexOf(q) >= 0 ||
					(u.nif||'').toLowerCase().indexOf(q) >= 0;
			});
			document.getElementById('user-count').textContent = list.length + ' / ' + allUsers.length + ' usuario(s)';

			var tb = document.getElementById('users-tbody');
			if (list.length === 0) { tb.innerHTML = '<tr><td colspan="6" class="u-sub">Sin resultados.</td></tr>'; return; }

			tb.innerHTML = list.map(function(u){
				var nombre = ((u.nombre||'') + ' ' + (u.apellido||'')).trim() || '<span class="u-sub">—</span>';
				var loc = [u.localidad, u.pais].filter(Boolean).join(', ') || '<span class="u-sub">—</span>';
				var nkeys = (u.pub_keys || []).length;
				var roleBadge = u.role === 'admin'
					? '<span class="role-badge role-admin">admin</span>'
					: '<span class="role-badge role-user">usuario</span>';
				return '<tr>' +
					'<td><div class="u-name">' + esc(u.username) + '</div><div>' + roleBadge + '</div></td>' +
					'<td>' + esc(((u.nombre||'') + ' ' + (u.apellido||'')).trim()) + (((u.nombre||'')+(u.apellido||'')) ? '' : '<span class="u-sub">—</span>') + '</td>' +
					'<td class="u-mono">' + (esc(u.nif) || '<span class="u-sub">—</span>') + '</td>' +
					'<td>' + esc([u.localidad, u.pais].filter(Boolean).join(', ')) + (((u.localidad||'')||(u.pais||'')) ? '' : '<span class="u-sub">—</span>') + '</td>' +
					'<td>' + (nkeys ? nkeys + ' clave(s)' : '<span class="u-sub">sin claves</span>') + '</td>' +
					'<td><div class="u-actions">' +
						'<button class="btn btn-outline btn-xs" onclick="openEditModal(\'' + u.id + '\')">Editar</button>' +
						'<button class="btn btn-danger btn-xs" onclick="deleteUser(\'' + u.id + '\', \'' + esc(u.username) + '\')">Eliminar</button>' +
					'</div></td>' +
				'</tr>';
			}).join('');
		}

		function findUser(id) { return allUsers.filter(function(u){ return u.id === id; })[0]; }

		async function deleteUser(id, username) {
			if (!confirm('¿Eliminar al usuario "' + username + '"? Esta acción no se puede deshacer.')) return;
			var r = await fetch('/admin/usuarios/' + id + '/delete', { method: 'POST' });
			var d = await r.json().catch(function(){ return {}; });
			if (!d.ok) { alert(d.msg || 'No se pudo eliminar'); return; }
			loadUsers();
		}

		// ---------- modal ----------
		var modalMode = 'edit';
		var MF = ['username','password','role','display_name','nombre','apellido','nif','email','telefono','direccion','localidad','codigo_postal','pais'];

		function setField(k, v) { var el = document.getElementById('m-' + k); if (el) el.value = (v == null ? '' : v); }

		function openCreateModal() {
			modalMode = 'create';
			document.getElementById('modal-title').textContent = 'Nuevo usuario';
			document.getElementById('m-id').value = '';
			MF.forEach(function(k){ setField(k, ''); });
			setField('role', 'user');
			setField('pais', 'ES');
			document.getElementById('m-username').removeAttribute('disabled');
			document.getElementById('m-username-field').style.display = '';
			document.getElementById('m-password-field').style.display = '';
			document.getElementById('m-edit-extra').style.display = 'none';
			document.getElementById('m-create-hint').style.display = '';
			document.getElementById('modal-error').classList.add('hidden');
			document.getElementById('user-modal').classList.add('open');
		}

		function openEditModal(id) {
			var u = findUser(id);
			if (!u) return;
			modalMode = 'edit';
			document.getElementById('modal-title').textContent = 'Editar: ' + u.username;
			document.getElementById('m-id').value = u.id;
			setField('username', u.username);
			setField('role', u.role);
			setField('display_name', u.display_name);
			setField('nombre', u.nombre);
			setField('apellido', u.apellido);
			setField('nif', u.nif);
			setField('email', u.email);
			setField('telefono', u.telefono);
			setField('direccion', u.direccion);
			setField('localidad', u.localidad);
			setField('codigo_postal', u.codigo_postal);
			setField('pais', u.pais);
			setField('newpass', '');
			document.getElementById('m-pass-result').innerHTML = '';
			// In edit mode username is read-only and there's no initial password field.
			document.getElementById('m-username').setAttribute('disabled', 'disabled');
			document.getElementById('m-password-field').style.display = 'none';
			document.getElementById('m-edit-extra').style.display = '';
			document.getElementById('m-create-hint').style.display = 'none';
			renderModalPubkeys(u.pub_keys || []);
			document.getElementById('modal-error').classList.add('hidden');
			document.getElementById('user-modal').classList.add('open');
		}

		function closeUserModal() { document.getElementById('user-modal').classList.remove('open'); }
		document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeUserModal(); });

		// Reparent the modal to <body> so it escapes the <main> stacking context
		// (otherwise the footer, a sibling of <main>, paints over it).
		(function(){
			var m = document.getElementById('user-modal');
			if (m && m.parentElement !== document.body) document.body.appendChild(m);
		})();

		function modalPayload() {
			return {
				username: document.getElementById('m-username').value.trim(),
				password: document.getElementById('m-password').value,
				role: document.getElementById('m-role').value,
				display_name: document.getElementById('m-display_name').value.trim(),
				nombre: document.getElementById('m-nombre').value.trim(),
				apellido: document.getElementById('m-apellido').value.trim(),
				nif: document.getElementById('m-nif').value.trim(),
				email: document.getElementById('m-email').value.trim(),
				telefono: document.getElementById('m-telefono').value.trim(),
				direccion: document.getElementById('m-direccion').value.trim(),
				localidad: document.getElementById('m-localidad').value.trim(),
				codigo_postal: document.getElementById('m-codigo_postal').value.trim(),
				pais: document.getElementById('m-pais').value.trim()
			};
		}

		function modalError(msg) {
			var el = document.getElementById('modal-error');
			el.textContent = msg; el.classList.remove('hidden');
		}

		async function saveUser() {
			var p = modalPayload();
			var id = document.getElementById('m-id').value;
			var url, body;
			if (modalMode === 'create') {
				if (!p.username) { modalError('El usuario es obligatorio'); return; }
				if (!p.password || p.password.length < 6) { modalError('La contraseña inicial debe tener al menos 6 caracteres'); return; }
				url = '/admin/usuarios';
			} else {
				url = '/admin/usuarios/' + id + '/update';
			}
			var r = await fetch(url, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(p) });
			var d = await r.json().catch(function(){ return {}; });
			if (!d.ok) { modalError(d.msg || 'No se pudo guardar'); return; }
			closeUserModal();
			loadUsers();
		}

		async function resetPassword() {
			var id = document.getElementById('m-id').value;
			var np = document.getElementById('m-newpass').value;
			var el = document.getElementById('m-pass-result');
			if (!np || np.length < 6) { el.innerHTML = '<div class="alert alert-error">Mínimo 6 caracteres.</div>'; return; }
			var r = await fetch('/admin/usuarios/' + id + '/password', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ password: np }) });
			var d = await r.json().catch(function(){ return {}; });
			el.innerHTML = d.ok
				? '<div class="alert alert-success">' + (d.msg || 'Contraseña restablecida') + '</div>'
				: '<div class="alert alert-error">' + (d.msg || 'Error') + '</div>';
			if (d.ok) document.getElementById('m-newpass').value = '';
		}

		function renderModalPubkeys(keys) {
			var el = document.getElementById('m-pubkeys');
			if (!keys || keys.length === 0) { el.innerHTML = '<p class="u-sub">Sin claves vinculadas.</p>'; return; }
			el.innerHTML = keys.map(function(pk){
				return '<div class="pk-row"><span class="u-mono">' + esc(pk) + '</span>' +
					'<button class="pk-del" title="Quitar" onclick="removePubkey(\'' + esc(pk) + '\')">&times;</button></div>';
			}).join('');
		}

		async function addPubkey() {
			var id = document.getElementById('m-id').value;
			var pub = document.getElementById('m-newpub').value.trim();
			if (!pub) return;
			var r = await fetch('/admin/usuarios/' + id + '/pubkeys', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ pub: pub }) });
			var d = await r.json().catch(function(){ return {}; });
			if (!d.ok) { alert(d.msg || 'No se pudo añadir'); return; }
			document.getElementById('m-newpub').value = '';
			await refreshModalUser(id);
		}

		async function removePubkey(pub) {
			var id = document.getElementById('m-id').value;
			if (!confirm('¿Quitar esta clave pública?')) return;
			var r = await fetch('/admin/usuarios/' + id + '/pubkeys/remove', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ pub: pub }) });
			var d = await r.json().catch(function(){ return {}; });
			if (!d.ok) { alert(d.msg || 'No se pudo quitar'); return; }
			await refreshModalUser(id);
		}

		// Reload the user list and refresh the modal's pubkey section in place.
		async function refreshModalUser(id) {
			await new Promise(function(res){ fetch('/admin/usuarios').then(function(r){return r.json();}).then(function(data){
				if (data.ok) { allUsers = data.usuarios || []; renderUsers(); }
				res();
			}).catch(res); });
			var u = findUser(id);
			if (u) renderModalPubkeys(u.pub_keys || []);
		}

		loadUsers();
		</script>
	}
}
