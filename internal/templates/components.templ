package templates

// SealIcon renders the notarial "verified seal" medallion. Pass a CSS class
// (e.g. "seal") so callers can size/colour it from base.templ.
templ SealIcon(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="12" cy="9" r="6"></circle>
		<path d="M9.2 9.3 11.1 11.2 14.8 7.3"></path>
		<path d="M8.4 14.1 7 21 l5-2.6 5 2.6 -1.4-6.9"></path>
	</svg>
}

// Icon renders a Lucide-style stroke icon by name.
templ Icon(name string) {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch name {
			case "plus":
				<path d="M5 12h14"></path>
				<path d="M12 5v14"></path>
			case "arrow-right":
				<path d="M5 12h14"></path>
				<path d="m12 5 7 7-7 7"></path>
			case "file-text":
				<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
				<path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
				<path d="M16 13H8"></path>
				<path d="M16 17H8"></path>
				<path d="M10 9H8"></path>
			case "file-plus":
				<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
				<path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
				<path d="M9 15h6"></path>
				<path d="M12 18v-6"></path>
			case "search":
				<circle cx="11" cy="11" r="8"></circle>
				<path d="m21 21-4.3-4.3"></path>
			case "key":
				<circle cx="7.5" cy="15.5" r="5.5"></circle>
				<path d="m21 2-9.6 9.6"></path>
				<path d="m15.5 7.5 3 3L22 7l-3-3"></path>
			case "shield-check":
				<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1Z"></path>
				<path d="m9 12 2 2 4-4"></path>
			case "repeat":
				<path d="m17 2 4 4-4 4"></path>
				<path d="M3 11v-1a4 4 0 0 1 4-4h14"></path>
				<path d="m7 22-4-4 4-4"></path>
				<path d="M21 13v1a4 4 0 0 1-4 4H3"></path>
			case "flame":
				<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
			case "check-circle":
				<path d="M21.8 10A10 10 0 1 1 17 3.3"></path>
				<path d="m9 11 3 3L22 4"></path>
			case "alert-circle":
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 8v4"></path>
				<path d="M12 16h.01"></path>
			case "info":
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 16v-4"></path>
				<path d="M12 8h.01"></path>
			case "clock":
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 6v6l4 2"></path>
			case "calendar":
				<path d="M8 2v4"></path>
				<path d="M16 2v4"></path>
				<rect width="18" height="18" x="3" y="4" rx="2"></rect>
				<path d="M3 10h18"></path>
			case "user":
				<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
				<circle cx="12" cy="7" r="4"></circle>
			case "sparkles":
				<path d="M9.9 15.5A2 2 0 0 0 8.5 14.1l-6.1-1.6a.5.5 0 0 1 0-1l6.1-1.6A2 2 0 0 0 9.9 8.5l1.6-6.1a.5.5 0 0 1 1 0l1.6 6.1a2 2 0 0 0 1.4 1.4l6.1 1.6a.5.5 0 0 1 0 1l-6.1 1.6a2 2 0 0 0-1.4 1.4l-1.6 6.1a.5.5 0 0 1-1 0z"></path>
			case "fingerprint":
				<path d="M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4"></path>
				<path d="M14 13.12c0 2.38 0 6.38-1 8.88"></path>
				<path d="M17.29 21.02c.12-.6.43-2.3.5-3.02"></path>
				<path d="M2 12a10 10 0 0 1 18-6"></path>
				<path d="M2 16h.01"></path>
				<path d="M21.8 16c.2-2 .131-5.354 0-6"></path>
				<path d="M5 19.5C5.5 18 6 15 6 12a6 6 0 0 1 .34-2"></path>
				<path d="M8.65 22c.21-.66.45-1.32.57-2"></path>
				<path d="M9 6.8a6 6 0 0 1 9 5.2v2"></path>
			default:
				<circle cx="12" cy="12" r="9"></circle>
		}
	</svg>
}

// StatusBadge renders a coloured pill for a pagaré estado (server-rendered).
templ StatusBadge(estado string) {
	switch estado {
		case "PAGADO":
			<span class="badge badge-pagado"><span class="dot"></span>Pagado</span>
		case "ANULADO":
			<span class="badge badge-anulado"><span class="dot"></span>Anulado</span>
		case "PRESCRITO":
			<span class="badge badge-prescrito"><span class="dot"></span>Prescrito</span>
		case "ENDOSADO":
			<span class="badge badge-endosado"><span class="dot"></span>Endosado</span>
		case "VENCIDO":
			<span class="badge badge-vencido"><span class="dot"></span>Vencido</span>
		default:
			<span class="badge badge-activo"><span class="dot"></span>Activo</span>
	}
}

// PageHead renders the standard page header (eyebrow + title + subtitle).
templ PageHead(eyebrow, title, subtitle string) {
	<div class="page-head">
		if eyebrow != "" {
			<span class="page-eyebrow">
				@SealIcon("")
				{ eyebrow }
			</span>
		}
		<h1 class="page-title">{ title }</h1>
		if subtitle != "" {
			<p class="page-subtitle">{ subtitle }</p>
		}
	</div>
}
