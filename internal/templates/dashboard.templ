package templates

templ Dashboard() {
	@Base("Pagarés") {
		<div class="flex-between mb-6">
			<div>
				<h1 class="page-title">Pagarés Electrónicos</h1>
				<p class="page-subtitle">Pagarés registrados en blockchain con validez fehaciente</p>
			</div>
			<a href="/pagares/nuevo" class="btn btn-primary">Emitir Pagaré</a>
		</div>
		<div id="pagares-list">
			<div class="card text-center">
				<p class="text-muted">Cargando pagarés...</p>
			</div>
		</div>
		<script>
		fetch('/api/pagares')
			.then(function(r) { return r.json(); })
			.then(function(data) {
				var el = document.getElementById('pagares-list');
				if (!data.ok || !data.assets || data.assets.length === 0) {
					el.innerHTML = '<div class="card text-center">' +
						'<p class="text-muted" style="font-size:1.1rem;margin-bottom:16px">No hay pagarés emitidos</p>' +
						'<a href="/pagares/nuevo" class="btn btn-primary">Emitir primer pagaré</a>' +
						'</div>';
					return;
				}
				var html = '<div class="card"><table>' +
					'<thead><tr>' +
					'<th>ID</th>' +
					'<th>Beneficiario</th>' +
					'<th>Importe</th>' +
					'<th>Vencimiento</th>' +
					'<th>Estado</th>' +
					'<th>Fecha</th>' +
					'<th>Acciones</th>' +
					'</tr></thead><tbody>';
				data.assets.forEach(function(a) {
					var d = a.data || {};
					var ben = d.beneficiario || {};
					var ven = d.vencimiento || {};
					var benStr = (ben.nombre || '') + ' ' + (ben.apellido || '');
					var impStr = (d.importe || '') + ' ' + (d.moneda || 'EUR');
					var venStr = ven.tipo === 'a_la_vista' ? 'A la vista' : (ven.fecha || '');
					var fechaStr = d.created_at ? new Date(d.created_at).toLocaleDateString() : '';
					var idShort = a.id ? a.id.substring(0, 12) + '...' : '';
					var estado = d.estado || '';
					var estadoHtml;
					if (estado === 'PAGADO') {
						estadoHtml = '<span class="tag" style="background:var(--c-success);color:white">Pagado</span>';
					} else if (estado === 'ANULADO') {
						estadoHtml = '<span class="tag" style="background:var(--c-danger);color:white">Anulado</span>';
					} else if (estado === 'PRESCRITO') {
						estadoHtml = '<span class="tag" style="background:var(--c-text-light);color:white">Prescrito</span>';
					} else if (ven.tipo !== 'a_la_vista' && ven.fecha && new Date(ven.fecha) < new Date()) {
						estadoHtml = '<span class="tag" style="background:#FF4D4D;color:white">Vencido</span>';
					} else {
						estadoHtml = '<span class="tag">Activo</span>';
					}
					var esFinalizado = estado === 'PAGADO' || estado === 'ANULADO' || estado === 'PRESCRITO';
					var acciones = '';
					if (!esFinalizado) {
						acciones += '<a href="/pagares/endosar?id=' + a.id + '" class="btn btn-outline btn-sm">Endosar</a> ' +
							'<a href="/pagares/pagar?id=' + a.id + '" class="btn btn-danger btn-sm">Pagar</a> ';
					}
					acciones += '<a href="/pagares/historico?id=' + a.id + '" class="btn btn-outline btn-sm">Histórico</a> ' +
						'<a href="/pagares/verificar?network=test&id=' + a.id + '" class="btn btn-primary btn-sm">Verificar</a>';
					html += '<tr>' +
						'<td><code title="' + a.id + '">' + idShort + '</code></td>' +
						'<td>' + benStr.trim() + '</td>' +
						'<td><strong>' + impStr + '</strong></td>' +
						'<td>' + venStr + '</td>' +
						'<td>' + estadoHtml + '</td>' +
						'<td class="text-muted">' + fechaStr + '</td>' +
						'<td style="white-space:nowrap">' + acciones + '</td></tr>';
				});
				html += '</tbody></table></div>';
				if (data.count && data.count.pages && data.count.pages.total > 1) {
					html += '<p class="text-center text-muted mt-4">Página ' + data.count.pages.current + ' de ' + data.count.pages.total + ' (' + data.count.total + ' pagarés)</p>';
				}
				el.innerHTML = html;
			})
			.catch(function(err) {
				document.getElementById('pagares-list').innerHTML = '<div class="card"><p class="alert alert-error text-center">Error cargando pagarés: ' + err + '</p></div>';
			});
		</script>
	}
}
