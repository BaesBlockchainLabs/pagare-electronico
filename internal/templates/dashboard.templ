package templates

templ Dashboard(user *CurrentUser) {
	@Base("Pagarés", user) {
		<div class="flex-between mb-6">
			if user != nil && !user.IsAdmin {
				@PageHead("Mis pagarés", "Mis pagarés", "Pagarés electrónicos de los que eres titular o beneficiario.")
			} else {
				@PageHead("Cartera", "Tus pagarés", "Pagarés electrónicos registrados en un libro mayor electrónico eIDAS2.")
			}
			<a href="/pagares/nuevo" class="btn btn-primary">
				@Icon("plus")
				Emitir pagaré
			</a>
		</div>
		<div id="alert-banner"></div>
		<div id="pagares-list">
			<div class="pagares-grid">
				<div class="skeleton"></div>
				<div class="skeleton"></div>
				<div class="skeleton"></div>
			</div>
		</div>
		<script>
		fetch('/api/pagares/alertas')
			.then(function(r) { return r.json(); })
			.then(function(data) {
				if (!data.ok || !data.count) return;
				var counts = {};
				data.alertas.forEach(function(a) { counts[a.categoria] = (counts[a.categoria] || 0) + 1; });
				var labels = { VENCIDO: 'vencidos', CADUCADO_VISTA: 'caducados (a la vista)', PRESCRITO: 'prescritos' };
				var parts = Object.keys(counts).map(function(k) { return counts[k] + ' ' + (labels[k] || k); });
				document.getElementById('alert-banner').innerHTML =
					'<div class="alert alert-info"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 8v4"></path><path d="M12 16h.01"></path></svg>' +
					'<span><strong>' + data.count + ' pagaré(s) requieren atención:</strong> ' + parts.join(', ') + '. Revisa sus fechas de validez.</span></div>';
			})
			.catch(function() {});
		</script>
		<script>
		function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }

		function badgeHTML(estado) {
			var map = {
				PAGADO:    ['badge-pagado','Pagado'],
				ANULADO:   ['badge-anulado','Anulado'],
				PRESCRITO: ['badge-prescrito','Prescrito'],
				ENDOSADO:  ['badge-endosado','Endosado'],
				CEDIDO:    ['badge-endosado','Cedido'],
				PENDIENTE_ENTREGA: ['badge-vencido','Pendiente de entrega'],
				VENCIDO:   ['badge-vencido','Vencido']
			};
			var m = map[estado] || ['badge-activo','Activo'];
			return '<span class="badge ' + m[0] + '"><span class="dot"></span>' + m[1] + '</span>';
		}

		var SEAL = '<svg class="pc-watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"></circle><path d="M9.2 9.3 11.1 11.2 14.8 7.3"></path><path d="M8.4 14.1 7 21 l5-2.6 5 2.6 -1.4-6.9"></path></svg>';

		fetch('/api/pagares')
			.then(function(r) { return r.json(); })
			.then(function(data) {
				var el = document.getElementById('pagares-list');
				if (!data.ok || !data.assets || data.assets.length === 0) {
					el.innerHTML = '<div class="card empty">' +
						'<div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M9 15h6"></path><path d="M12 18v-6"></path></svg></div>' +
						'<p>Todavía no has emitido ningún pagaré.</p>' +
						'<a href="/pagares/nuevo" class="btn btn-primary">Emitir el primero</a>' +
						'</div>';
					return;
				}
				var cards = '<div class="pagares-grid">';
				data.assets.forEach(function(a) {
					var d = a.data || {};
					var ben = d.beneficiario || {};
					var ven = d.vencimiento || {};
					var benStr = ((ben.nombre || '') + ' ' + (ben.apellido || '')).trim() || '—';
					var impStr = (d.importe != null ? Number(d.importe).toLocaleString('es-ES', {minimumFractionDigits: 2}) : '') + ' ' + (d.moneda || 'EUR');
					var venStr = ven.tipo === 'a_la_vista' ? 'A la vista' : fmtFecha(ven.fecha);
					var fechaStr = fmtFecha(d.created_at);
					var idShort = a.id ? a.id.substring(0, 10) + '…' : '';
					var estado = d.estado || '';
					var sinAcciones = estado === 'PAGADO' || estado === 'ANULADO' || estado === 'PRESCRITO' || estado === 'ENDOSADO';

					var acc = '';
					if (!sinAcciones) {
						// Un pagaré "no a la orden" no es endosable (art. 14 LCCH):
						// solo cabe transmitirlo por cesión ordinaria.
						if (estado !== 'VENCIDO' && !d.no_a_la_orden) {
							acc += '<a href="/pagares/endosar?id=' + encodeURIComponent(a.id) + '" class="btn btn-outline btn-sm">Endosar</a>';
						}
						// La cesión ordinaria (arts. 347-348 CCom) cabe siempre: es la
						// única vía del pagaré "no a la orden", y en los demás una
						// alternativa al endoso con otros efectos, que la propia LCCH
						// reconoce en el art. 24.
						if (estado !== 'VENCIDO') {
							acc += '<a href="/pagares/ceder?id=' + encodeURIComponent(a.id) + '" class="btn btn-outline btn-sm">Ceder</a>';
						}
						// Emitido pero nunca entregado: el control sigue en el emisor
						// y el beneficiario aún no tiene nada. Se puede completar.
						if (estado === 'PENDIENTE_ENTREGA') {
							acc += '<button onclick="entregarPagare(\'' + a.id + '\')" class="btn btn-primary btn-sm">Entregar</button>';
						}
						acc += '<a href="/pagares/pagar?id=' + encodeURIComponent(a.id) + '" class="btn btn-danger btn-sm">Pagar</a>';
					}
					acc += '<a href="/pagares/historico?id=' + encodeURIComponent(a.id) + '" class="btn btn-ghost btn-sm">Histórico</a>';
					acc += '<a href="/api/pagares/pdf?id=' + encodeURIComponent(a.id) + '" class="btn btn-ghost btn-sm">PDF</a>';
					acc += '<a href="/pagares/verificar?network=test&id=' + encodeURIComponent(a.id) + '" class="btn btn-gold btn-sm">Verificar</a>';

					cards += '<article class="pagare-card">' + SEAL +
						'<div class="pc-head">' +
							'<div><div class="pc-label">Pagaré</div><div class="pc-id" title="' + esc(a.id) + '">' + esc(idShort) + '</div></div>' +
							badgeHTML(estado) +
						'</div>' +
						'<div class="pc-amount">' + esc(impStr) + '</div>' +
						'<div class="pc-rule"></div>' +
						'<div class="pc-meta">' +
							'<div class="row"><span>Beneficiario</span><span>' + esc(benStr) + '</span></div>' +
							'<div class="row"><span>Vencimiento</span><span>' + esc(venStr) + '</span></div>' +
							'<div class="row"><span>Emitido</span><span>' + esc(fechaStr) + '</span></div>' +
							(d.aval ? '<div class="row"><span>Aval</span><span>' + (d.aval.alcance === 'parcial' ? 'Parcial' : 'Total') + '</span></div>' : '') +
						'</div>' +
						'<div class="pc-actions">' + acc + '</div>' +
					'</article>';
				});
				cards += '</div>';
				if (data.count && data.count.pages && data.count.pages.total > 1) {
					cards += '<p class="text-center text-muted mt-6">Página ' + data.count.pages.current + ' de ' + data.count.pages.total + ' · ' + data.count.total + ' pagarés</p>';
				}
				el.innerHTML = cards;
			})
			.catch(function(err) {
				document.getElementById('pagares-list').innerHTML = '<div class="alert alert-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 8v4"></path><path d="M12 16h.01"></path></svg>Error cargando pagarés: ' + esc(err) + '</div>';
			});

		// Completar la entrega de un pagaré que se emitió sin llegar a su
		// beneficiario. El destino se resuelve en el servidor por el NIF que
		// consta en el título.
		function entregarPagare(id) {
			fetch('/api/pagares/entrega', {
				method: 'PUT',
				headers: {'Content-Type': 'application/json'},
				body: JSON.stringify({id: id})
			})
			.then(function(r) { return r.json(); })
			.then(function(data) {
				if (data.ok) {
					location.reload();
				} else {
					alert(data.msg || 'No se pudo entregar el pagaré');
				}
			})
			.catch(function(err) { alert('Error de conexión: ' + err.message); });
		}
		</script>
	}
}
