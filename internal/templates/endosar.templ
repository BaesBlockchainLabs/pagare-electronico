package templates

templ Endosar(user *CurrentUser) {
	@Base("Endosar Pagaré", user) {
		@PageHead("Transmisión", "Endosar un pagaré", "Transfiere un pagaré a un nuevo beneficiario. Arts. 14-24 de la LCCH (aplicables al pagaré por el art. 96).")
		<div class="card" style="max-width:760px">
			<form id="endoso-form" onsubmit="return endosarPagare(event)">
				<div class="field">
					<label class="form-label">ID del pagaré *</label>
					<input type="text" id="end-id" placeholder="ID del asset en blockchain"/>
				</div>
				<div class="field">
					<label class="form-label">Endosatario (nuevo beneficiario) *</label>
					<select id="end-to-select" onchange="onEndosatarioSelect(this.value)">
						<option value="">-- selecciona un usuario --</option>
					</select>
				</div>
				<label class="check-row" for="end-to-manual">
					<input type="checkbox" id="end-to-manual" onchange="toggleEndToManual()"/>
					<span>Introducir clave pública a mano <small>(endosatario no registrado)</small></span>
				</label>
				<div class="field">
					<input type="text" id="end-to" placeholder="Clave pública del nuevo beneficiario" readonly/>
				</div>
				<div class="form-grid">
					<div class="field">
						<label class="form-label">Tipo de endoso *</label>
						<select id="end-tipo">
							<option value="en_propiedad">En propiedad (art. 17)</option>
							<option value="en_procuracion">En procuración / cobranza (art. 21)</option>
							<option value="en_blanco">En blanco (art. 15)</option>
							<option value="en_garantia">En garantía / prenda (art. 22)</option>
						</select>
					</div>
					<div class="field">
						<label class="form-label">Cláusula</label>
						<select id="end-clausula">
							<option value="">Sin cláusula</option>
							<option value="sin_responsabilidad">Sin mi responsabilidad (art. 18)</option>
							<option value="no_a_la_orden">Prohibición de nuevo endoso (art. 18)</option>
							<option value="sin_gastos">Sin gastos / sin protesto (art. 56)</option>
						</select>
					</div>
				</div>
				<p class="desc">Endosas tú, el usuario logueado (endosante). El endoso se firma con tu identidad; no necesitas introducir claves.</p>
				<div id="endoso-no-orden" class="alert alert-info hidden">
					@Icon("info")
					Este pagaré se emitió <strong>"no a la orden"</strong> (art. 14 LCCH): no puede endosarse, solo transmitirse por cesión ordinaria.
				</div>
				<div id="endoso-error" class="alert alert-error hidden"></div>
				<div id="endoso-ok" class="alert alert-success hidden"></div>
				<div class="mt-4">
					<button type="submit" id="endoso-btn" class="btn btn-primary">
						@Icon("repeat")
						Endosar pagaré
					</button>
				</div>
			</form>
		</div>
		<script>
		var urlId = new URLSearchParams(window.location.search).get('id');
		if (urlId) document.getElementById('end-id').value = urlId;

		// Avisar antes de rellenar el formulario si el pagaré no es endosable.
		// El servidor lo rechaza igualmente, pero llegar hasta el botón para que
		// entonces falle es una pérdida de tiempo del usuario.
		function comprobarEndosable() {
			var id = document.getElementById('end-id').value.trim();
			var aviso = document.getElementById('endoso-no-orden');
			var btn = document.getElementById('endoso-btn');
			if (!id) { aviso.classList.add('hidden'); btn.disabled = false; return; }
			fetch('/api/pagares/buscar?id=' + encodeURIComponent(id))
				.then(function(r) { return r.json(); })
				.then(function(data) {
					var d = (data.asset && data.asset.data) || {};
					var bloqueado = !!d.no_a_la_orden;
					aviso.classList.toggle('hidden', !bloqueado);
					btn.disabled = bloqueado;
				})
				.catch(function(){});
		}
		document.getElementById('end-id').addEventListener('change', comprobarEndosable);
		if (urlId) comprobarEndosable();

		function endosarPagare(e) {
			e.preventDefault();
			var errEl = document.getElementById('endoso-error');
			var okEl = document.getElementById('endoso-ok');
			var btn = document.getElementById('endoso-btn');
			errEl.classList.add('hidden');
			okEl.classList.add('hidden');

			var payload = {
				id: document.getElementById('end-id').value.trim(),
				to: document.getElementById('end-to').value.trim(),
				metadata: {
					tipo_endoso: document.getElementById('end-tipo').value,
					clausula: document.getElementById('end-clausula').value || undefined
				}
			};
			// El servidor firma con la clave del usuario logueado; no se envía 'from'.

			btn.disabled = true;
			btn.textContent = 'Endosando…';

			fetch('/api/pagares/endoso', {
				method: 'PUT',
				headers: {'Content-Type': 'application/json'},
				body: JSON.stringify(payload)
			})
			.then(function(r) { return r.json(); })
			.then(function(data) {
				btn.disabled = false;
				btn.textContent = 'Endosar pagaré';
				if (data.ok) {
					okEl.textContent = 'Pagaré endosado correctamente.';
					okEl.classList.remove('hidden');
				} else {
					errEl.textContent = data.msg || 'Error';
					if (data.errors) errEl.textContent += ': ' + data.errors.map(function(e){return e.mensaje}).join('; ');
					errEl.classList.remove('hidden');
				}
			})
			.catch(function(err) {
				btn.disabled = false;
				btn.textContent = 'Endosar pagaré';
				errEl.textContent = 'Error: ' + err;
				errEl.classList.remove('hidden');
			});
			return false;
		}

		// Cargar usuarios para el desplegable de endosatario.
		function loadEndosatarios() {
			fetch('/api/usuarios')
				.then(function(r){ return r.json(); })
				.then(function(data){
					if (!data.ok || !data.usuarios) return;
					var sel = document.getElementById('end-to-select');
					sel.innerHTML = '<option value="">-- selecciona un usuario --</option>';
					data.usuarios.forEach(function(u){
						if (!u.pub_keys || u.pub_keys.length === 0) return; // sin clave no puede recibir
						var opt = document.createElement('option');
						opt.value = u.pub_keys[0];
						opt.textContent = (u.nombre||'') + ' ' + (u.apellido||'') + ' (' + (u.nif||'') + ')';
						sel.appendChild(opt);
					});
				})
				.catch(function(){});
		}
		function onEndosatarioSelect(pub) {
			if (document.getElementById('end-to-manual').checked) return;
			document.getElementById('end-to').value = pub || '';
		}
		function toggleEndToManual() {
			var manual = document.getElementById('end-to-manual').checked;
			document.getElementById('end-to-select').disabled = manual;
			var to = document.getElementById('end-to');
			to.readOnly = !manual;
			if (manual) { document.getElementById('end-to-select').value=''; to.value=''; }
		}

		loadEndosatarios();
		</script>
	}
}
