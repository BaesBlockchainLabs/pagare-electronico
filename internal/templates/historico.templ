package templates

templ Historico(id string) {
	@Base("Histórico") {
		<h1 class="page-title">Histórico de Pagaré</h1>
		<p class="page-subtitle">Consulta el historial completo de eventos de un pagaré en blockchain.</p>
		<div class="card">
			<label class="form-label">ID del Pagaré (asset)</label>
			<div class="flex-between">
				<input type="text" id="pagare-id" value={ id } placeholder="ID del asset en blockchain" style="flex:1;margin-right:12px"/>
				<button class="btn btn-primary btn-sm" onclick="loadHistorico()">Buscar</button>
			</div>
			<div id="historico-result" class="mt-6"></div>
		</div>
		<script>
		var urlId = new URLSearchParams(window.location.search).get('id') || document.getElementById('pagare-id').value;
		if (urlId) {
			document.getElementById('pagare-id').value = urlId;
			loadHistorico();
		}
		function loadHistorico() {
			var id = document.getElementById('pagare-id').value.trim();
			if (!id) return;
			document.getElementById('historico-result').innerHTML = '<p class="text-center text-muted" style="padding:32px 0">Cargando...</p>';
			fetch('/api/pagares/historico?id=' + encodeURIComponent(id))
				.then(function(r) { return r.json(); })
				.then(function(data) {
					var el = document.getElementById('historico-result');
					if (!data.ok) { el.innerHTML = '<div class="alert alert-error">' + data.msg + '</div>'; return; }
					if (!data.history || data.history.length === 0) { el.innerHTML = '<p class="text-muted">Sin historial</p>'; return; }
					var html = '<div class="timeline">';
					data.history.forEach(function(h, i) {
						var meta = h.metadata || {};
						var action = meta.action || '';
						var label = meta.action_label || action;
						var dotClass = 'default';
						if (action === 'CREATE') dotClass = 'create';
						else if (action === 'TRANSFER' || action === 'ENDOSO') dotClass = 'endoso';
						else if (action === 'BURN' || action === 'PAGO') dotClass = 'pago';
						html += '<div class="timeline-item">';
						html += '<div class="timeline-dot ' + dotClass + '">' + (i+1) + '</div>';
						html += '<div style="flex:1">';
						html += '<div style="font-weight:700;color:var(--c-dark)">' + label + '</div>';
						if (meta.fecha) html += '<div class="text-muted" style="font-size:0.85rem">' + meta.fecha + '</div>';
						if (meta.from) html += '<div style="font-size:0.9rem;margin-top:4px"><strong>Origen:</strong> <code>' + meta.from + '</code></div>';
						if (meta.to) html += '<div style="font-size:0.9rem"><strong>Destino:</strong> <code>' + meta.to + '</code></div>';
						if (meta.tipo_cierre_label) html += '<div style="font-size:0.9rem;margin-top:4px"><strong>Tipo:</strong> <span class="tag">' + meta.tipo_cierre_label + '</span></div>';
						if (meta.tipo_endoso_label) html += '<div style="font-size:0.9rem"><strong>Tipo endoso:</strong> <span class="tag">' + meta.tipo_endoso_label + '</span></div>';
						if (meta.clausula) html += '<div style="font-size:0.9rem"><strong>Cláusula:</strong> ' + meta.clausula + '</div>';
						if (meta.motivo) html += '<div style="font-size:0.9rem"><strong>Motivo:</strong> ' + meta.motivo + '</div>';
						if (meta.motivo_cierre) html += '<div style="font-size:0.9rem"><strong>Motivo cierre:</strong> ' + meta.motivo_cierre + '</div>';
						if (meta.referencia) html += '<div style="font-size:0.9rem"><strong>Referencia:</strong> ' + meta.referencia + '</div>';
						if (meta.endosante) html += '<div style="font-size:0.9rem"><strong>Endosante:</strong> <code>' + meta.endosante + '</code></div>';
						if (meta.endosatario) html += '<div style="font-size:0.9rem"><strong>Endosatario:</strong> <code>' + meta.endosatario + '</code></div>';
						html += '</div></div>';
					});
					html += '</div>';
					el.innerHTML = html;
				})
				.catch(function(e) { document.getElementById('historico-result').innerHTML = '<div class="alert alert-error">Error: ' + e + '</div>'; });
		}
		</script>
	}
}
