package templates

templ Identidades(user *CurrentUser) {
	@Base("Identidades", user) {
		@PageHead("Criptografía", "Identidades digitales", "Claves criptográficas e identidades digitales para firmar y verificar pagarés.")
		<div class="grid-2">
			<div class="card">
				<h2 class="card-title">Generar keypair blockchain</h2>
				<p class="desc">Genera un par de claves ed25519 a partir de una semilla y un PIN. Para usuarios regulares: úsalo para tu propia identidad.</p>
				<div class="field">
					<label class="form-label">Semilla *</label>
					<input type="text" id="kp-seed" placeholder="Texto semilla (> 16 caracteres)"/>
				</div>
				<div class="field">
					<label class="form-label">PIN *</label>
					<input type="text" id="kp-pin" placeholder="4-16 caracteres alfanuméricos" maxlength="16"/>
				</div>
				<button class="btn btn-primary btn-sm" onclick="generateKeypair()">
					@Icon("key")
					Generar keypair
				</button>
				<div id="gen-keypair" class="mt-4"></div>
			</div>
			<div class="card">
				<h2 class="card-title">Cargar clave para firmar</h2>
				<p class="desc">Sube un JSON de clave (con <code>pub</code> y <code>pvt</code>) descargado al generar un keypair. Quedará activo para firmar tus operaciones (emitir, endosar, pagar) hasta que cierres sesión o la pestaña.</p>
				<div class="field">
					<label class="form-label">Fichero JSON</label>
					<input type="file" id="keyfile" accept="application/json,.json" onchange="loadKeyFile(this)"/>
				</div>
				<div id="keyfile-status" class="mt-2"></div>
			</div>
			<div class="card" style="grid-column:1/-1">
				<h2 class="card-title">Generar identidad digital (DID Sovrin)</h2>
				<p class="desc">Genera una identidad digital para firmar, verificar, cifrar y descifrar.</p>
				<div class="flex-between">
					<div class="field" style="flex:1;margin:0">
						<label class="form-label">Semilla (hex 64 chars, opcional)</label>
						<input type="text" id="did-seed" placeholder="Dejar vacío para identidad aleatoria"/>
					</div>
					<button class="btn btn-primary btn-sm" onclick="generateDID()" style="align-self:flex-end">
						@Icon("fingerprint")
						Generar DID
					</button>
				</div>
				<div id="gen-did" class="mt-4"></div>
			</div>

			<!-- Personal key claim section (visible to all logged users) -->
			<div class="card" style="grid-column:1/-1; margin-top: 16px;">
				<h2 class="card-title">Vincular clave a mi cuenta</h2>
				<p class="desc">Asocia una pubkey (de keypair generado arriba u otro) a tu usuario para que los pagarés de los que seas propietario aparezcan en tu vista filtrada.</p>

				<div class="form-grid">
					<div class="field">
						<label class="form-label">Pub a vincular</label>
						<input type="text" id="claim-pub" placeholder="la pub del keypair"/>
					</div>
					<div class="field">
						<label class="form-label">Pvt (temporal, sólo para este claim)</label>
						<input type="text" id="claim-pvt" placeholder="pvt correspondiente (no se guarda)"/>
					</div>
				</div>

				<div id="claim-result" class="mt-2"></div>

				<button class="btn btn-primary btn-sm" onclick="claimKey()" style="margin-top:8px;">
					Vincular esta clave
				</button>

				<div id="my-pubkeys" class="mt-4" style="font-size:0.9rem;"></div>
			</div>
		</div>
		<script>
		function generateKeypair() {
			var seed = document.getElementById('kp-seed').value;
			var pin = document.getElementById('kp-pin').value;
			if (!seed || !pin) { alert('Semilla y PIN son obligatorios'); return; }
			document.getElementById('gen-keypair').innerHTML = '<p class="text-muted">Generando…</p>';
			fetch('/api/identidades/keypair', {
				method: 'POST',
				headers: {'Content-Type': 'application/json'},
				body: JSON.stringify({seed: seed, pin: pin})
			})
			.then(function(r) { return r.json(); })
			.then(function(data) {
				var el = document.getElementById('gen-keypair');
				if (!data.ok) { el.innerHTML = '<div class="alert alert-error">' + data.msg + '</div>'; return; }
				el.innerHTML = '<div class="alert alert-success">Keypair generado</div>' +
					keyField('Pub', data.pub) +
					keyField('Pvt (clave privada)', data.pvt) +
					'<p style="font-size:0.8rem;color:var(--danger)">Guarda estas claves de forma segura. No se almacenan en el servidor.</p>' +
					'<div class="key-actions">' +
						'<button type="button" class="btn btn-sm btn-outline" id="kp-download">Descargar JSON</button>' +
						'<button type="button" class="btn btn-sm btn-primary" id="kp-claim">Vincular esta clave a mi cuenta</button>' +
					'</div>' +
					'<div id="kp-claim-msg" class="mt-2"></div>';
				document.getElementById('kp-download').addEventListener('click', function() {
					downloadJSON('pagare-keypair-' + String(data.pub).slice(0, 8) + '.json', {
						type: 'ed25519-keypair', pub: data.pub, pvt: data.pvt, generated_at: new Date().toISOString()
					});
				});
				document.getElementById('kp-claim').addEventListener('click', function() { claimGeneratedKey(data.pub, data.pvt); });

				// Auto-vincular the generated key (makes the flow much simpler for regular users)
				claimGeneratedKey(data.pub, data.pvt);
			})
			.catch(function(e) { document.getElementById('gen-keypair').innerHTML = '<div class="alert alert-error">Error: ' + e + '</div>'; });
		}

		function generateDID() {
			var seed = document.getElementById('did-seed').value;
			document.getElementById('gen-did').innerHTML = '<p class="text-muted">Generando…</p>';
			fetch('/api/identidades/did', {
				method: 'POST',
				headers: {'Content-Type': 'application/json'},
				body: JSON.stringify({seed: seed || undefined})
			})
			.then(function(r) { return r.json(); })
			.then(function(data) {
				var el = document.getElementById('gen-did');
				if (!data.ok) { el.innerHTML = '<div class="alert alert-error">' + data.msg + '</div>'; return; }
				var id = data.identity || {};
				var sec = id.secret || {};
				el.innerHTML = '<div class="alert alert-success">Identidad DID generada</div>' +
					'<div class="form-grid">' +
					keyField('DID', id.did || '') +
					keyField('Verify Key', id.verify_key || '') +
					keyField('Encryption Public Key', id.encryption_public_key || '') +
					(sec.seed ? keyField('Seed', sec.seed) : '<div></div>') +
					(sec.sign_key ? keyField('Sign Key', sec.sign_key) : '<div></div>') +
					'</div>' +
					'<p style="font-size:0.8rem;color:var(--danger)">Guarda la parte secreta de forma segura.</p>' +
					'<div class="key-actions"><button type="button" class="btn btn-sm btn-outline" id="did-download">Descargar JSON</button></div>';
				document.getElementById('did-download').addEventListener('click', function() {
					var fid = (id.did || 'did').replace(/[^a-zA-Z0-9]/g, '').slice(0, 12);
					downloadJSON('pagare-did-' + fid + '.json', { type: 'did-sovrin', identity: id, generated_at: new Date().toISOString() });
				});
			})
			.catch(function(e) { document.getElementById('gen-did').innerHTML = '<div class="alert alert-error">Error: ' + e + '</div>'; });
		}

		// Load and display current user's linked pubkeys (their "Mis identidades")
		function loadMyPubkeys() {
			var el = document.getElementById('my-pubkeys');
			if (!el) return;
			fetch('/api/auth/me')
				.then(function(r) { return r.json(); })
				.then(function(data) {
					if (!data.ok || !data.pub_keys || data.pub_keys.length === 0) {
						el.innerHTML = '<p style="color:var(--ink-soft);">No tienes claves vinculadas todavía. Genera un keypair arriba y vincúlalo.</p>';
						return;
					}
					var html = '<strong>Tus claves vinculadas:</strong><ul style="margin:6px 0 0 16px;padding:0;">';
					data.pub_keys.forEach(function(pk) {
						html += '<li style="font-family:monospace;font-size:0.85rem;">' + pk + '</li>';
					});
					html += '</ul>';
					el.innerHTML = html;
				})
				.catch(function() { el.innerHTML = '<p style="color:var(--ink-soft);">No se pudieron cargar tus claves.</p>'; });
		}

		function claimKey() {
			var el = document.getElementById('claim-result');
			var pub = document.getElementById('claim-pub').value.trim();
			var pvt = document.getElementById('claim-pvt').value.trim();
			el.innerHTML = '';

			if (!pub) {
				el.innerHTML = '<div class="alert alert-error">Pub es obligatoria</div>';
				return;
			}

			var payload = { pub: pub };
			if (pvt) payload.pvt = pvt;  // convenience path (pvt never stored)

			fetch('/api/auth/claim', {
				method: 'POST',
				headers: {'Content-Type': 'application/json'},
				body: JSON.stringify(payload)
			})
			.then(function(r) { return r.json(); })
			.then(function(data) {
				if (data && data.ok) {
					el.innerHTML = '<div class="alert alert-success">' + (data.msg || 'Clave vinculada correctamente') + '</div>';
					loadMyPubkeys();  // refresh the list
				} else {
					el.innerHTML = '<div class="alert alert-error">' + (data && data.msg || 'Error al vincular') + '</div>';
				}
			})
			.catch(function(e) {
				el.innerHTML = '<div class="alert alert-error">Error: ' + e + '</div>';
			});
		}

		// One-click claim right after generating a keypair (uses the pvt convenience path)
		function claimGeneratedKey(pub, pvt) {
			// Write the result to a dedicated sub-container so we never touch the
			// innerHTML of #gen-keypair (which would drop the listeners on the
			// Descargar/Vincular buttons).
			function setMsg(html) {
				var msg = document.getElementById('kp-claim-msg');
				if (msg) msg.innerHTML = html;
			}
			fetch('/api/auth/claim', {
				method: 'POST',
				headers: {'Content-Type': 'application/json'},
				body: JSON.stringify({ pub: pub, pvt: pvt })
			})
			.then(function(r) { return r.json(); })
			.then(function(data) {
				if (data && data.ok) {
					setMsg('<div class="alert alert-success">¡Clave vinculada a tu cuenta!</div>');
					loadMyPubkeys();
				} else {
					setMsg('<div class="alert alert-error">' + (data && data.msg || 'Error al vincular') + '</div>');
				}
			})
			.catch(function(e) {
				setMsg('<div class="alert alert-error">Error: ' + e + '</div>');
			});
		}

		// ---------- cargar clave para firmar ----------
		function loadKeyFile(input) {
			var status = document.getElementById('keyfile-status');
			var f = input.files && input.files[0];
			if (!f) return;
			var reader = new FileReader();
			reader.onload = function() {
				try {
					var obj = JSON.parse(reader.result);
					if (!obj.pub || !obj.pvt) throw new Error('el JSON debe contener "pub" y "pvt"');
					setActiveKey(obj);
					renderActiveKeyStatus();
				} catch (e) {
					status.innerHTML = '<div class="alert alert-error">No se pudo cargar: ' + (e.message || e) + '</div>';
				}
				input.value = '';
			};
			reader.onerror = function() { status.innerHTML = '<div class="alert alert-error">No se pudo leer el fichero.</div>'; };
			reader.readAsText(f);
		}

		function renderActiveKeyStatus() {
			var status = document.getElementById('keyfile-status');
			if (!status) return;
			var k = getActiveKey();
			if (!k || !k.pub) {
				status.innerHTML = '<p class="u-sub" style="color:var(--ink-soft);font-size:0.85rem;">No hay clave activa. Las operaciones pedirán pub/pvt manualmente.</p>';
				return;
			}
			status.innerHTML = '<div class="alert alert-success" style="display:flex;justify-content:space-between;align-items:center;gap:12px;">' +
				'<span>Clave activa: <strong style="font-family:ui-monospace,monospace;">' + k.pub.slice(0, 18) + '…</strong> — se usará para firmar hasta el cierre de sesión.</span>' +
				'<a href="#" style="font-weight:600;" onclick="clearActiveKey();renderActiveKeyStatus();return false;">Quitar</a></div>';
		}

		// Auto-load user's keys when the page finishes loading
		setTimeout(loadMyPubkeys, 300);
		renderActiveKeyStatus();
		</script>
	}
}
