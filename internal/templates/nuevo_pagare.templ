package templates

templ NuevoPagare(isDev bool, user *CurrentUser) {
	@Base("Emitir Pagaré", user) {
		<div class="flex-between mb-6">
			@PageHead("Emisión", "Emitir un nuevo pagaré", "Formulario conforme al art. 94 de la LCCH. Los datos se graban de forma inalterable en blockchain.")
			if isDev {
				<button type="button" class="btn btn-outline btn-sm" onclick="rellenarAleatorio()">
					@Icon("sparkles")
					Datos de prueba
				</button>
			}
		</div>

		<form id="pagare-form" onsubmit="return emitirPagare(event)">
			<fieldset>
				<legend>Datos del pagaré</legend>
				<div class="form-grid">
					<div class="field">
						<label class="form-label" for="denominacion">Denominación</label>
						<input type="text" id="denominacion" name="denominacion" value="PAGARÉ" readonly/>
					</div>
					<div class="field">
						<label class="form-label" for="importe">Importe (EUR) *</label>
						<input type="number" id="importe" name="importe" step="0.01" min="0.01" required/>
					</div>
					<div class="field">
						<label class="form-label" for="vencimiento_tipo">Tipo de vencimiento *</label>
						<select id="vencimiento_tipo" name="vencimiento_tipo" required>
							<option value="fecha_fija">Fecha fija</option>
							<option value="a_la_vista">A la vista (art. 39 LCCH)</option>
						</select>
					</div>
					<div class="field">
						<label class="form-label" for="vencimiento_fecha">Fecha de vencimiento</label>
						<input type="date" id="vencimiento_fecha" name="vencimiento_fecha"/>
					</div>
					<div class="field">
						<label class="form-label" for="localidad_pago">Localidad de pago *</label>
						<input type="text" id="localidad_pago" name="localidad_pago" required/>
					</div>
					<div class="field">
						<label class="form-label" for="localidad_emision">Localidad de emisión *</label>
						<input type="text" id="localidad_emision" name="localidad_emision" required/>
					</div>
					<div class="field">
						<label class="form-label" for="fecha_emision">Fecha de emisión</label>
						<input type="date" id="fecha_emision" name="fecha_emision"/>
					</div>
				</div>
				<label class="check-row" for="no_a_la_orden">
					<input type="checkbox" id="no_a_la_orden" name="no_a_la_orden"/>
					<span>
						<b>"No a la orden"</b> (art. 14 LCCH)
						<small>El pagaré no podrá endosarse, solo transmitirse por cesión ordinaria.</small>
					</span>
				</label>
			</fieldset>

			<fieldset>
				<legend>Beneficiario</legend>
				<div class="field">
					<label class="form-label">Seleccionar de usuarios registrados (sale de la base de datos)</label>
					<select id="beneficiario-select" onchange="fillFromUser(this.value, 'beneficiario')">
						<option value="">-- teclear a mano o seleccionar --</option>
					</select>
				</div>
				<div class="form-grid-3">
					<div class="field">
						<label class="form-label" for="beneficiario_nombre">Nombre *</label>
						<input type="text" id="beneficiario_nombre" name="beneficiario_nombre" required/>
					</div>
					<div class="field">
						<label class="form-label" for="beneficiario_apellido">Apellidos</label>
						<input type="text" id="beneficiario_apellido" name="beneficiario_apellido"/>
					</div>
					<div class="field">
						<label class="form-label" for="beneficiario_nif">NIF / NIE / CIF *</label>
						<input type="text" id="beneficiario_nif" name="beneficiario_nif" required placeholder="12345678Z"/>
					</div>
				</div>
			</fieldset>

			<fieldset>
				<legend>Firmante</legend>
				<div class="field">
					<label class="form-label">Seleccionar de usuarios registrados (sale de la base de datos)</label>
					<select id="firmante-select" onchange="fillFromUser(this.value, 'firmante')">
						<option value="">-- teclear a mano o seleccionar --</option>
					</select>
				</div>
				<div class="form-grid-3">
					<div class="field">
						<label class="form-label" for="firmante_nombre">Nombre *</label>
						<input type="text" id="firmante_nombre" name="firmante_nombre" required/>
					</div>
					<div class="field">
						<label class="form-label" for="firmante_apellido">Apellidos</label>
						<input type="text" id="firmante_apellido" name="firmante_apellido"/>
					</div>
					<div class="field">
						<label class="form-label" for="firmante_nif">NIF / NIE / CIF *</label>
						<input type="text" id="firmante_nif" name="firmante_nif" required/>
					</div>
				</div>
				<div class="form-grid">
					<div class="field">
						<label class="form-label" for="firmante_direccion">Dirección *</label>
						<input type="text" id="firmante_direccion" name="firmante_direccion" required/>
					</div>
					<div class="field">
						<label class="form-label" for="firmante_localidad">Localidad *</label>
						<input type="text" id="firmante_localidad" name="firmante_localidad" required/>
					</div>
					<div class="field">
						<label class="form-label" for="firmante_cp">Código postal *</label>
						<input type="text" id="firmante_cp" name="firmante_cp" required/>
					</div>
					<div class="field">
						<label class="form-label" for="firmante_pais">País (ISO) *</label>
						<input type="text" id="firmante_pais" name="firmante_pais" required value="ES" maxlength="2"/>
					</div>
				</div>
			</fieldset>

			<fieldset>
				<legend>Identidad blockchain del firmante (opcional)</legend>
				<p style="font-size:0.85rem; color:var(--ink-soft); margin-bottom:8px;">Usa una de tus claves vinculadas para firmar. El pub se vinculará automáticamente a tu cuenta tras emitir.</p>
				<div id="firmante-active-key" class="mb-4"></div>
				<div class="field">
					<label class="form-label">Mis claves vinculadas</label>
					<select id="firmante-from-pub-select" onchange="if (this.value) document.getElementById('firmante-from-pub').value = this.value;">
						<option value="">-- cargar mis claves --</option>
					</select>
				</div>
				<div class="form-grid">
					<div class="field">
						<label class="form-label">Clave pública</label>
						<input type="text" id="firmante-from-pub" placeholder="pub de tu keypair"/>
					</div>
					<div class="field">
						<label class="form-label">Clave privada (temporal)</label>
						<input type="text" id="firmante-from-pvt" placeholder="pvt (solo para esta emisión)"/>
					</div>
				</div>
			</fieldset>

			<fieldset>
				<legend>Aval (opcional)</legend>
				<label class="check-row" for="aval_enabled">
					<input type="checkbox" id="aval_enabled" name="aval_enabled" onchange="toggleAval()"/>
					<span>
						<b>Añadir un aval a este pagaré</b> (arts. 35-37 LCCH)
						<small>Un tercero (avalista) garantiza el pago, total o parcialmente.</small>
					</span>
				</label>
				<div id="aval-fields" class="hidden mt-4">
					<div class="form-grid-3">
						<div class="field">
							<label class="form-label" for="avalista_nombre">Nombre del avalista *</label>
							<input type="text" id="avalista_nombre" name="avalista_nombre"/>
						</div>
						<div class="field">
							<label class="form-label" for="avalista_apellido">Apellidos</label>
							<input type="text" id="avalista_apellido" name="avalista_apellido"/>
						</div>
						<div class="field">
							<label class="form-label" for="avalista_nif">NIF / NIE / CIF *</label>
							<input type="text" id="avalista_nif" name="avalista_nif"/>
						</div>
					</div>
					<div class="form-grid-3">
						<div class="field">
							<label class="form-label" for="aval_alcance">Alcance *</label>
							<select id="aval_alcance" name="aval_alcance" onchange="toggleAvalParcial()">
								<option value="total">Total</option>
								<option value="parcial">Parcial</option>
							</select>
						</div>
						<div class="field hidden" id="aval-parcial-field">
							<label class="form-label" for="aval_importe">Importe avalado (EUR) *</label>
							<input type="number" id="aval_importe" name="aval_importe" step="0.01" min="0.01"/>
						</div>
						<div class="field">
							<label class="form-label" for="aval_avalado">Avalado (a quién se avala)</label>
							<input type="text" id="aval_avalado" name="aval_avalado" placeholder="Por defecto, el firmante (art. 36)"/>
						</div>
					</div>
				</div>
			</fieldset>

			<div id="form-error" class="alert alert-error hidden"></div>
			<div id="form-success" class="alert alert-success hidden"></div>

			<div style="text-align: right; margin-top: 8px;">
				<button type="submit" id="submit-btn" class="btn btn-primary">
					@SealIcon("")
					Emitir y grabar en blockchain
				</button>
			</div>
		</form>

		<script>
		var nombres = ['María','Juan','Ana','Carlos','Laura','Pedro','Elena','Miguel','Isabel','Javier'];
		var apellidos = ['García','Fernández','López','Martínez','Sánchez','Pérez','Gómez','Martín','Jiménez','Ruiz'];
		var ciudades = ['Madrid','Barcelona','Valencia','Sevilla','Bilbao','Zaragoza','Málaga','Murcia','Palma','A Coruña'];
		var calles = ['Calle Mayor 10','Av. de la Constitución 25','Paseo del Prado 8','Calle Gran Vía 42','Rambla de Cataluña 15','Calle Alcalá 100'];

		function toggleAval() {
			var on = document.getElementById('aval_enabled').checked;
			document.getElementById('aval-fields').classList.toggle('hidden', !on);
		}
		function toggleAvalParcial() {
			var parcial = document.getElementById('aval_alcance').value === 'parcial';
			document.getElementById('aval-parcial-field').classList.toggle('hidden', !parcial);
		}

		function pick(arr) { return arr[Math.floor(Math.random()*arr.length)]; }
		function randNIF() {
			var n = Math.floor(10000000+Math.random()*89999999);
			var l = 'TRWAGMYFPDXBNJZSQVHLCKE';
			return n + l[n%23];
		}
		function futureDate() {
			var d = new Date();
			d.setMonth(d.getMonth()+1+Math.floor(Math.random()*11));
			return d.toISOString().split('T')[0];
		}

		function rellenarAleatorio() {
			var f = document.getElementById('pagare-form');
			var n1 = pick(nombres), a1 = pick(apellidos);
			var n2 = pick(nombres), a2 = pick(apellidos);
			f.importe.value = (100+Math.floor(Math.random()*9900)).toFixed(2);
			f.vencimiento_tipo.value = Math.random()>0.3 ? 'fecha_fija' : 'a_la_vista';
			f.vencimiento_fecha.value = futureDate();
			f.localidad_pago.value = pick(ciudades);
			f.localidad_emision.value = pick(ciudades);
			f.fecha_emision.value = new Date().toISOString().split('T')[0];
			f.beneficiario_nombre.value = n1;
			f.beneficiario_apellido.value = a1;
			f.beneficiario_nif.value = randNIF();
			f.firmante_nombre.value = n2;
			f.firmante_apellido.value = a2;
			f.firmante_nif.value = randNIF();
			f.firmante_direccion.value = pick(calles);
			f.firmante_localidad.value = pick(ciudades);
			f.firmante_cp.value = String(10000+Math.floor(Math.random()*89999));
			f.firmante_pais.value = 'ES';
		}

		function emitirPagare(e) {
			e.preventDefault();
			var f = document.getElementById('pagare-form');
			var errEl = document.getElementById('form-error');
			var okEl = document.getElementById('form-success');
			var btn = document.getElementById('submit-btn');
			errEl.classList.add('hidden');
			okEl.classList.add('hidden');

			var payload = {
				asset: {
					data: {
						type: "pagare_electronico",
						denominacion: f.denominacion.value,
						promesa_pago: true,
						importe: parseFloat(f.importe.value),
						moneda: "EUR",
						vencimiento: { tipo: f.vencimiento_tipo.value, fecha: f.vencimiento_fecha.value },
						localidad_pago: f.localidad_pago.value,
						beneficiario: { nombre: f.beneficiario_nombre.value, apellido: f.beneficiario_apellido.value, nif: f.beneficiario_nif.value },
						localidad_emision: f.localidad_emision.value,
						fecha_emision: f.fecha_emision.value,
						no_a_la_orden: f.no_a_la_orden.checked,
						firmante: {
							nombre: f.firmante_nombre.value,
							apellido: f.firmante_apellido.value,
							nif: f.firmante_nif.value,
							direccion_postal: {
								direccion: f.firmante_direccion.value,
								localidad: f.firmante_localidad.value,
								codigo_postal: f.firmante_cp.value,
								pais: f.firmante_pais.value
							}
						}
					}
				}
			};

			// Collect optional blockchain identity for signing (from pub/pvt)
			var fromPub = document.getElementById('firmante-from-pub').value.trim();
			var fromPvt = document.getElementById('firmante-from-pvt').value.trim();
			if (fromPub && fromPvt) {
				payload.from = { pub: fromPub, pvt: fromPvt };
			}

			if (document.getElementById('aval_enabled').checked) {
				var alcance = f.aval_alcance.value;
				payload.asset.data.aval = {
					avalista: { nombre: f.avalista_nombre.value, apellido: f.avalista_apellido.value, nif: f.avalista_nif.value },
					alcance: alcance,
					avalado: f.aval_avalado.value || undefined
				};
				if (alcance === 'parcial') {
					payload.asset.data.aval.importe_parcial = parseFloat(f.aval_importe.value);
				}
			}

			btn.disabled = true;
			btn.textContent = "Emitiendo…";

			fetch('/api/pagares', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(payload)
			})
			.then(function(r) { return r.json(); })
			.then(function(data) {
				btn.disabled = false;
				btn.textContent = "Emitir y grabar en blockchain";
				if (data.ok) {
					okEl.textContent = "Pagaré emitido correctamente. ID: " + data.id + " (coste: " + data.cost + ")";
					okEl.classList.remove('hidden');

					// Auto-link the from pub we just used (so the asset belongs to the regular user)
					if (fromPub && fromPvt) {
						fetch('/api/auth/claim', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ pub: fromPub, pvt: fromPvt })
						}).catch(function(){});
					}

					f.reset();
					f.denominacion.value = "PAGARÉ";
					f.firmante_pais.value = "ES";
					toggleAval();
					toggleAvalParcial();
					window.scrollTo({top: 0, behavior: 'smooth'});
				} else {
					errEl.textContent = data.msg || 'Error desconocido';
					if (data.errors) {
						errEl.textContent += ': ' + data.errors.map(function(e){ return e.mensaje; }).join('; ');
					}
					errEl.classList.remove('hidden');
				}
			})
			.catch(function(err) {
				btn.disabled = false;
				btn.textContent = "Emitir y grabar en blockchain";
				errEl.textContent = "Error de conexión: " + err.message;
				errEl.classList.remove('hidden');
			});

			return false;
		}

		// Pre-fill the signing pub with one of the user's linked keys (for regular users)
		// and populate the dropdown
		fetch('/api/auth/me')
			.then(function(r) { return r.json(); })
			.then(function(data) {
				if (data && data.ok && data.pub_keys && data.pub_keys.length > 0) {
					var fp = document.getElementById('firmante-from-pub');
					var sel = document.getElementById('firmante-from-pub-select');
					if (sel) {
						// clear and add options
						sel.innerHTML = '<option value="">-- seleccionar mi clave --</option>';
						data.pub_keys.forEach(function(pk) {
							var opt = document.createElement('option');
							opt.value = pk;
							opt.textContent = pk.substring(0, 20) + '...';
							sel.appendChild(opt);
						});
					}
					if (fp && !fp.value && data.pub_keys.length > 0) {
						fp.value = data.pub_keys[0];
					}
				}
			})
			.catch(function(){});

		// Cargar usuarios de la plataforma para los selects (sale de la "BBDD" de usuarios)
		function loadUsuariosPlataforma() {
			fetch('/api/usuarios')
				.then(function(r) { return r.json(); })
				.then(function(data) {
					if (!data.ok || !data.usuarios) return;
					var bens = document.getElementById('beneficiario-select');
					var firs = document.getElementById('firmante-select');
					if (bens) {
						bens.innerHTML = '<option value="">-- teclear a mano o seleccionar --</option>';
						data.usuarios.forEach(function(u) {
							var opt = document.createElement('option');
							opt.value = JSON.stringify(u);
							opt.textContent = (u.nombre || '') + ' ' + (u.apellido || '') + ' (' + (u.nif || '') + ')';
							bens.appendChild(opt);
						});
					}
					if (firs) {
						firs.innerHTML = '<option value="">-- teclear a mano o seleccionar --</option>';
						data.usuarios.forEach(function(u) {
							var opt = document.createElement('option');
							opt.value = JSON.stringify(u);
							opt.textContent = (u.nombre || '') + ' ' + (u.apellido || '') + ' (' + (u.nif || '') + ')';
							firs.appendChild(opt);
						});
					}
				})
				.catch(function(){});
		}

		function fillFromUser(jsonStr, tipo) {
			if (!jsonStr) return;
			var u;
			try { u = JSON.parse(jsonStr); } catch(e) { return; }
			if (tipo === 'beneficiario') {
				document.getElementById('beneficiario_nombre').value = u.nombre || '';
				document.getElementById('beneficiario_apellido').value = u.apellido || '';
				document.getElementById('beneficiario_nif').value = u.nif || '';
			} else if (tipo === 'firmante') {
				document.getElementById('firmante_nombre').value = u.nombre || '';
				document.getElementById('firmante_apellido').value = u.apellido || '';
				document.getElementById('firmante_nif').value = u.nif || '';
				document.getElementById('firmante_direccion').value = u.direccion || '';
				document.getElementById('firmante_localidad').value = u.localidad || '';
				document.getElementById('firmante_cp').value = u.codigo_postal || '';
				document.getElementById('firmante_pais').value = u.pais || 'ES';
				// Repopulate pub dropdown with this user's keys
				var pubSel = document.getElementById('firmante-from-pub-select');
				var pubIn = document.getElementById('firmante-from-pub');
				if (pubSel && u.pub_keys) {
					pubSel.innerHTML = '<option value="">-- seleccionar clave --</option>';
					u.pub_keys.forEach(function(pk) {
						var o = document.createElement('option');
						o.value = pk;
						o.textContent = pk.substring(0,18) + '...';
						pubSel.appendChild(o);
					});
					if (u.pub_keys.length > 0 && pubIn) pubIn.value = u.pub_keys[0];
				}
			}
		}

		// Cargar al inicio
		loadUsuariosPlataforma();
		// Prefill the signing identity from the active key (if loaded in /identidades).
		applyActiveKey('firmante-from-pub', 'firmante-from-pvt', 'firmante-active-key');
		</script>
	}
}
