package templates

templ NuevoPagare(isDev bool) {
	@Base("Emitir Pagaré") {
		<div class="flex-between mb-4">
			<div>
				<h1 class="page-title">Emitir Nuevo Pagaré</h1>
				<p class="page-subtitle">Formulario de emisión conforme al art. 94 de la LCCH. Los datos se grabarán de forma inalterable en blockchain.</p>
			</div>
			if isDev {
				<button type="button" class="btn btn-outline btn-sm" onclick="rellenarAleatorio()">Rellenar datos aleatorios (DEV)</button>
			}
		</div>

		<form id="pagare-form" onsubmit="return emitirPagare(event)">
			<fieldset>
				<legend>Datos del Pagaré</legend>
				<div class="form-grid">
					<div>
						<label class="form-label" for="denominacion">Denominación</label>
						<input type="text" id="denominacion" name="denominacion" value="PAGARÉ" readonly/>
					</div>
					<div>
						<label class="form-label" for="importe">Importe (EUR) *</label>
						<input type="number" id="importe" name="importe" step="0.01" min="0.01" required/>
					</div>
					<div>
						<label class="form-label" for="vencimiento_tipo">Tipo Vencimiento *</label>
						<select id="vencimiento_tipo" name="vencimiento_tipo" required>
							<option value="fecha_fija">Fecha fija</option>
							<option value="a_la_vista">A la vista (art. 39 LCCH)</option>
						</select>
					</div>
					<div>
						<label class="form-label" for="vencimiento_fecha">Fecha Vencimiento</label>
						<input type="date" id="vencimiento_fecha" name="vencimiento_fecha"/>
					</div>
					<div>
						<label class="form-label" for="localidad_pago">Localidad de Pago *</label>
						<input type="text" id="localidad_pago" name="localidad_pago" required/>
					</div>
					<div>
						<label class="form-label" for="localidad_emision">Localidad de Emisión *</label>
						<input type="text" id="localidad_emision" name="localidad_emision" required/>
					</div>
					<div>
						<label class="form-label" for="fecha_emision">Fecha de Emisión</label>
						<input type="date" id="fecha_emision" name="fecha_emision"/>
					</div>
				</div>
			</fieldset>

			<fieldset>
				<legend>Beneficiario</legend>
				<div class="form-grid-3">
					<div>
						<label class="form-label" for="beneficiario_nombre">Nombre *</label>
						<input type="text" id="beneficiario_nombre" name="beneficiario_nombre" required/>
					</div>
					<div>
						<label class="form-label" for="beneficiario_apellido">Apellidos</label>
						<input type="text" id="beneficiario_apellido" name="beneficiario_apellido"/>
					</div>
					<div>
						<label class="form-label" for="beneficiario_nif">NIF/NIE/CIF *</label>
						<input type="text" id="beneficiario_nif" name="beneficiario_nif" required placeholder="12345678Z"/>
					</div>
				</div>
			</fieldset>

			<fieldset>
				<legend>Firmante</legend>
				<div class="form-grid-3">
					<div>
						<label class="form-label" for="firmante_nombre">Nombre *</label>
						<input type="text" id="firmante_nombre" name="firmante_nombre" required/>
					</div>
					<div>
						<label class="form-label" for="firmante_apellido">Apellidos</label>
						<input type="text" id="firmante_apellido" name="firmante_apellido"/>
					</div>
					<div>
						<label class="form-label" for="firmante_nif">NIF/NIE/CIF *</label>
						<input type="text" id="firmante_nif" name="firmante_nif" required/>
					</div>
				</div>
				<div class="form-grid mt-4">
					<div>
						<label class="form-label" for="firmante_direccion">Dirección *</label>
						<input type="text" id="firmante_direccion" name="firmante_direccion" required/>
					</div>
					<div>
						<label class="form-label" for="firmante_localidad">Localidad *</label>
						<input type="text" id="firmante_localidad" name="firmante_localidad" required/>
					</div>
					<div>
						<label class="form-label" for="firmante_cp">Código Postal *</label>
						<input type="text" id="firmante_cp" name="firmante_cp" required/>
					</div>
					<div>
						<label class="form-label" for="firmante_pais">País (ISO) *</label>
						<input type="text" id="firmante_pais" name="firmante_pais" required value="ES" maxlength="2"/>
					</div>
				</div>
			</fieldset>

			<div id="form-error" class="alert alert-error hidden"></div>
			<div id="form-success" class="alert alert-success hidden"></div>

			<div style="text-align: right; margin-top: 24px;">
				<button type="submit" id="submit-btn" class="btn btn-primary">
					Emitir y Grabar en Blockchain
				</button>
			</div>
		</form>

		<script>
		var nombres = ['María','Juan','Ana','Carlos','Laura','Pedro','Elena','Miguel','Isabel','Javier'];
		var apellidos = ['García','Fernández','López','Martínez','Sánchez','Pérez','Gómez','Martín','Jiménez','Ruiz'];
		var ciudades = ['Madrid','Barcelona','Valencia','Sevilla','Bilbao','Zaragoza','Málaga','Murcia','Palma','A Coruña'];
		var calles = ['Calle Mayor 10','Av. de la Constitución 25','Paseo del Prado 8','Calle Gran Vía 42','Rambla de Cataluña 15','Calle Alcalá 100'];

		function pick(arr) { return arr[Math.floor(Math.random()*arr.length)]; }
		function randNIF() {
			var n = Math.floor(10000000+Math.random()*89999999);
			var l = 'TRWAGMYFPDXBNJZSQVHLCKE';
			return n + l[n%23];
		}
		function futureDate() {
			var d = new Date();
			d.setMonth(d.getMonth()+1+Math.floor(Math.random()*11));
			return d.toISOString().split('T')[0];
		}

		function rellenarAleatorio() {
			var f = document.getElementById('pagare-form');
			var n1 = pick(nombres), a1 = pick(apellidos);
			var n2 = pick(nombres), a2 = pick(apellidos);
			f.importe.value = (100+Math.floor(Math.random()*9900)).toFixed(2);
			f.vencimiento_tipo.value = Math.random()>0.3 ? 'fecha_fija' : 'a_la_vista';
			f.vencimiento_fecha.value = futureDate();
			f.localidad_pago.value = pick(ciudades);
			f.localidad_emision.value = pick(ciudades);
			f.fecha_emision.value = new Date().toISOString().split('T')[0];
			f.beneficiario_nombre.value = n1;
			f.beneficiario_apellido.value = a1;
			f.beneficiario_nif.value = randNIF();
			f.firmante_nombre.value = n2;
			f.firmante_apellido.value = a2;
			f.firmante_nif.value = randNIF();
			f.firmante_direccion.value = pick(calles);
			f.firmante_localidad.value = pick(ciudades);
			f.firmante_cp.value = String(10000+Math.floor(Math.random()*89999));
			f.firmante_pais.value = 'ES';
		}

		function emitirPagare(e) {
			e.preventDefault();
			var f = document.getElementById('pagare-form');
			var errEl = document.getElementById('form-error');
			var okEl = document.getElementById('form-success');
			var btn = document.getElementById('submit-btn');
			errEl.classList.add('hidden');
			okEl.classList.add('hidden');

			var payload = {
				asset: {
					data: {
						type: "pagare_electronico",
						denominacion: f.denominacion.value,
						promesa_pago: true,
						importe: parseFloat(f.importe.value),
						moneda: "EUR",
						vencimiento: { tipo: f.vencimiento_tipo.value, fecha: f.vencimiento_fecha.value },
						localidad_pago: f.localidad_pago.value,
						beneficiario: { nombre: f.beneficiario_nombre.value, apellido: f.beneficiario_apellido.value, nif: f.beneficiario_nif.value },
						localidad_emision: f.localidad_emision.value,
						fecha_emision: f.fecha_emision.value,
						firmante: {
							nombre: f.firmante_nombre.value,
							apellido: f.firmante_apellido.value,
							nif: f.firmante_nif.value,
							direccion_postal: {
								direccion: f.firmante_direccion.value,
								localidad: f.firmante_localidad.value,
								codigo_postal: f.firmante_cp.value,
								pais: f.firmante_pais.value
							}
						}
					}
				}
			};

			btn.disabled = true;
			btn.textContent = "Emitiendo...";

			fetch('/api/pagares', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(payload)
			})
			.then(function(r) { return r.json(); })
			.then(function(data) {
				btn.disabled = false;
				btn.textContent = "Emitir y Grabar en Blockchain";
				if (data.ok) {
					okEl.textContent = "Pagaré emitido correctamente. ID: " + data.id + " (coste: " + data.cost + ")";
					okEl.classList.remove('hidden');
					f.reset();
					f.denominacion.value = "PAGARÉ";
					f.firmante_pais.value = "ES";
				} else {
					errEl.textContent = data.msg || 'Error desconocido';
					if (data.errors) {
						errEl.textContent += ': ' + data.errors.map(function(e){ return e.mensaje; }).join('; ');
					}
					errEl.classList.remove('hidden');
				}
			})
			.catch(function(err) {
				btn.disabled = false;
				btn.textContent = "Emitir y Grabar en Blockchain";
				errEl.textContent = "Error de conexión: " + err.message;
				errEl.classList.remove('hidden');
			});

			return false;
		}
		</script>
	}
}
