package templates

templ NuevoPagare(isDev bool, user *CurrentUser) {
	@Base("Emitir Pagaré", user) {
		<div class="flex-between mb-6">
			@PageHead("Emisión", "Emitir un nuevo pagaré", "Formulario conforme al art. 94 de la LCCH. Los datos se graban de forma inalterable en blockchain.")
		</div>

		<form id="pagare-form" onsubmit="return emitirPagare(event)">
			<fieldset>
				<legend>Datos del pagaré</legend>
				<div class="form-grid">
					<div class="field">
						<label class="form-label" for="denominacion">Denominación</label>
						<input type="text" id="denominacion" name="denominacion" value="PAGARÉ" readonly/>
					</div>
					<div class="field">
						<label class="form-label" for="importe">Importe (EUR) *</label>
						<input type="number" id="importe" name="importe" step="0.01" min="0.01" required/>
					</div>
					<div class="field">
						<label class="form-label" for="vencimiento_tipo">Tipo de vencimiento *</label>
						<select id="vencimiento_tipo" name="vencimiento_tipo" required>
							<option value="fecha_fija">Fecha fija</option>
							<option value="a_la_vista">A la vista (art. 39 LCCH)</option>
						</select>
					</div>
					<div class="field">
						<label class="form-label" for="vencimiento_fecha">Fecha de vencimiento</label>
						<input type="date" id="vencimiento_fecha" name="vencimiento_fecha"/>
					</div>
					<div class="field">
						<label class="form-label" for="localidad_pago">Localidad de pago *</label>
						<input type="text" id="localidad_pago" name="localidad_pago" required/>
					</div>
					<div class="field">
						<label class="form-label" for="localidad_emision">Localidad de emisión *</label>
						<input type="text" id="localidad_emision" name="localidad_emision" required/>
					</div>
					<div class="field">
						<label class="form-label" for="fecha_emision">Fecha de emisión</label>
						<input type="date" id="fecha_emision" name="fecha_emision"/>
					</div>
				</div>
				<label class="check-row" for="no_a_la_orden">
					<input type="checkbox" id="no_a_la_orden" name="no_a_la_orden"/>
					<span>
						<b>"No a la orden"</b> (art. 14 LCCH)
						<small>El pagaré no podrá endosarse, solo transmitirse por cesión ordinaria.</small>
					</span>
				</label>
			</fieldset>

			<fieldset>
				<legend>Beneficiario</legend>
				<div class="field">
					<label class="form-label">Seleccionar usuario registrado</label>
					<select id="beneficiario-select" onchange="fillFromUser(this.value, 'beneficiario')">
						<option value="">-- selecciona un usuario --</option>
					</select>
				</div>
				<label class="check-row" for="beneficiario-manual">
					<input type="checkbox" id="beneficiario-manual" onchange="toggleManual('beneficiario')"/>
					<span>Introducir a mano <small>(para un beneficiario que no está registrado en la plataforma)</small></span>
				</label>
				<div class="form-grid-3">
					<div class="field">
						<label class="form-label" for="beneficiario_nombre">Nombre *</label>
						<input type="text" id="beneficiario_nombre" name="beneficiario_nombre" required readonly/>
					</div>
					<div class="field">
						<label class="form-label" for="beneficiario_apellido">Apellidos</label>
						<input type="text" id="beneficiario_apellido" name="beneficiario_apellido" readonly/>
					</div>
					<div class="field">
						<label class="form-label" for="beneficiario_nif">NIF / NIE / CIF *</label>
						<input type="text" id="beneficiario_nif" name="beneficiario_nif" required placeholder="12345678Z" readonly/>
					</div>
				</div>
			</fieldset>

			<fieldset>
				<legend>Firmante (emisor)</legend>
				<p class="desc" style="margin-bottom:10px;">Eres tú, el usuario que emite el pagaré. Tus datos se rellenan automáticamente y el pagaré se firma con tu identidad; no necesitas introducir claves.</p>
				<label class="check-row" for="firmante-editar">
					<input type="checkbox" id="firmante-editar" onchange="toggleEmisorEdit()"/>
					<span>Editar mis datos para este pagaré <small>(no modifica tu perfil)</small></span>
				</label>
				<div class="form-grid-3">
					<div class="field">
						<label class="form-label" for="firmante_nombre">Nombre *</label>
						<input type="text" id="firmante_nombre" name="firmante_nombre" required readonly/>
					</div>
					<div class="field">
						<label class="form-label" for="firmante_apellido">Apellidos</label>
						<input type="text" id="firmante_apellido" name="firmante_apellido" readonly/>
					</div>
					<div class="field">
						<label class="form-label" for="firmante_nif">NIF / NIE / CIF *</label>
						<input type="text" id="firmante_nif" name="firmante_nif" required readonly/>
					</div>
				</div>
				<div class="form-grid">
					<div class="field">
						<label class="form-label" for="firmante_direccion">Dirección *</label>
						<input type="text" id="firmante_direccion" name="firmante_direccion" required readonly/>
					</div>
					<div class="field">
						<label class="form-label" for="firmante_localidad">Localidad *</label>
						<input type="text" id="firmante_localidad" name="firmante_localidad" required readonly/>
					</div>
					<div class="field">
						<label class="form-label" for="firmante_cp">Código postal *</label>
						<input type="text" id="firmante_cp" name="firmante_cp" required readonly/>
					</div>
					<div class="field">
						<label class="form-label" for="firmante_pais">País (ISO) *</label>
						<input type="text" id="firmante_pais" name="firmante_pais" required value="ES" maxlength="2" readonly/>
					</div>
				</div>
			</fieldset>

			<fieldset>
				<legend>Aval (opcional)</legend>
				<label class="check-row" for="aval_enabled">
					<input type="checkbox" id="aval_enabled" name="aval_enabled" onchange="toggleAval()"/>
					<span>
						<b>Añadir un aval a este pagaré</b> (arts. 35-37 LCCH)
						<small>Un tercero (avalista) garantiza el pago, total o parcialmente.</small>
					</span>
				</label>
				<div id="aval-fields" class="hidden mt-4">
					<div class="form-grid-3">
						<div class="field">
							<label class="form-label" for="avalista_nombre">Nombre del avalista *</label>
							<input type="text" id="avalista_nombre" name="avalista_nombre"/>
						</div>
						<div class="field">
							<label class="form-label" for="avalista_apellido">Apellidos</label>
							<input type="text" id="avalista_apellido" name="avalista_apellido"/>
						</div>
						<div class="field">
							<label class="form-label" for="avalista_nif">NIF / NIE / CIF *</label>
							<input type="text" id="avalista_nif" name="avalista_nif"/>
						</div>
					</div>
					<div class="form-grid-3">
						<div class="field">
							<label class="form-label" for="aval_alcance">Alcance *</label>
							<select id="aval_alcance" name="aval_alcance" onchange="toggleAvalParcial()">
								<option value="total">Total</option>
								<option value="parcial">Parcial</option>
							</select>
						</div>
						<div class="field hidden" id="aval-parcial-field">
							<label class="form-label" for="aval_importe">Importe avalado (EUR) *</label>
							<input type="number" id="aval_importe" name="aval_importe" step="0.01" min="0.01"/>
						</div>
						<div class="field">
							<label class="form-label" for="aval_avalado">Avalado (a quién se avala)</label>
							<input type="text" id="aval_avalado" name="aval_avalado" placeholder="Por defecto, el firmante (art. 36)"/>
						</div>
					</div>
				</div>
			</fieldset>

			<div id="form-error" class="alert alert-error hidden"></div>
			<div id="form-success" class="alert alert-success hidden"></div>

			<div style="text-align: right; margin-top: 8px;">
				<button type="submit" id="submit-btn" class="btn btn-primary">
					@SealIcon("")
					Emitir y grabar en blockchain
				</button>
			</div>
		</form>

		<script>
		function toggleAval() {
			var on = document.getElementById('aval_enabled').checked;
			document.getElementById('aval-fields').classList.toggle('hidden', !on);
		}
		function toggleAvalParcial() {
			var parcial = document.getElementById('aval_alcance').value === 'parcial';
			document.getElementById('aval-parcial-field').classList.toggle('hidden', !parcial);
		}

		function emitirPagare(e) {
			e.preventDefault();
			var f = document.getElementById('pagare-form');
			var errEl = document.getElementById('form-error');
			var okEl = document.getElementById('form-success');
			var btn = document.getElementById('submit-btn');
			errEl.classList.add('hidden');
			okEl.classList.add('hidden');

			var payload = {
				asset: {
					data: {
						type: "pagare_electronico",
						denominacion: f.denominacion.value,
						promesa_pago: true,
						importe: parseFloat(f.importe.value),
						moneda: "EUR",
						vencimiento: { tipo: f.vencimiento_tipo.value, fecha: f.vencimiento_fecha.value },
						localidad_pago: f.localidad_pago.value,
						beneficiario: { nombre: f.beneficiario_nombre.value, apellido: f.beneficiario_apellido.value, nif: f.beneficiario_nif.value },
						localidad_emision: f.localidad_emision.value,
						fecha_emision: f.fecha_emision.value,
						no_a_la_orden: f.no_a_la_orden.checked,
						firmante: {
							nombre: f.firmante_nombre.value,
							apellido: f.firmante_apellido.value,
							nif: f.firmante_nif.value,
							direccion_postal: {
								direccion: f.firmante_direccion.value,
								localidad: f.firmante_localidad.value,
								codigo_postal: f.firmante_cp.value,
								pais: f.firmante_pais.value
							}
						}
					}
				}
			};

			// No blockchain identity is sent: the server signs on our behalf with
			// the logged-in user's stored key.

			if (document.getElementById('aval_enabled').checked) {
				var alcance = f.aval_alcance.value;
				payload.asset.data.aval = {
					avalista: { nombre: f.avalista_nombre.value, apellido: f.avalista_apellido.value, nif: f.avalista_nif.value },
					alcance: alcance,
					avalado: f.aval_avalado.value || undefined
				};
				if (alcance === 'parcial') {
					payload.asset.data.aval.importe_parcial = parseFloat(f.aval_importe.value);
				}
			}

			btn.disabled = true;
			btn.textContent = "Emitiendo…";

			fetch('/api/pagares', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(payload)
			})
			.then(function(r) { return r.json(); })
			.then(function(data) {
				btn.disabled = false;
				btn.textContent = "Emitir y grabar en blockchain";
				if (data.ok) {
					okEl.textContent = "Pagaré emitido correctamente. ID: " + data.id + " (coste: " + data.cost + ")";
					okEl.classList.remove('hidden');

					f.reset();
					f.denominacion.value = "PAGARÉ";
					f.firmante_pais.value = "ES";
					document.getElementById('beneficiario-manual').checked = false;
					toggleManual('beneficiario');
					document.getElementById('firmante-editar').checked = false;
					fetchAndFillEmisor();
					toggleAval();
					toggleAvalParcial();
					window.scrollTo({top: 0, behavior: 'smooth'});
				} else {
					errEl.textContent = data.msg || 'Error desconocido';
					if (data.errors) {
						errEl.textContent += ': ' + data.errors.map(function(e){ return e.mensaje; }).join('; ');
					}
					errEl.classList.remove('hidden');
				}
			})
			.catch(function(err) {
				btn.disabled = false;
				btn.textContent = "Emitir y grabar en blockchain";
				errEl.textContent = "Error de conexión: " + err.message;
				errEl.classList.remove('hidden');
			});

			return false;
		}

		// Autocompletar el emisor (firmante) con los datos del usuario logueado.
		var BENEF_IDS = ['beneficiario_nombre','beneficiario_apellido','beneficiario_nif'];
		var EMISOR_IDS = ['firmante_nombre','firmante_apellido','firmante_nif','firmante_direccion','firmante_localidad','firmante_cp','firmante_pais'];

		function fetchAndFillEmisor() {
			fetch('/api/perfil')
				.then(function(r) { return r.json(); })
				.then(function(u) {
					if (!u || !u.ok) return;
					document.getElementById('firmante_nombre').value = u.nombre || '';
					document.getElementById('firmante_apellido').value = u.apellido || '';
					document.getElementById('firmante_nif').value = u.nif || '';
					document.getElementById('firmante_direccion').value = u.direccion || '';
					document.getElementById('firmante_localidad').value = u.localidad || '';
					document.getElementById('firmante_cp').value = u.codigo_postal || '';
					document.getElementById('firmante_pais').value = u.pais || 'ES';
				})
				.catch(function(){});
		}

		// Editar a mano los datos del emisor (sin tocar el perfil).
		function toggleEmisorEdit() {
			var on = document.getElementById('firmante-editar').checked;
			EMISOR_IDS.forEach(function(id){ document.getElementById(id).readOnly = !on; });
			if (!on) fetchAndFillEmisor(); // al desmarcar, restauramos mis datos
		}

		// Beneficiario: desplegable por defecto; "introducir a mano" para no registrados.
		function toggleManual(tipo) {
			if (tipo !== 'beneficiario') return;
			var manual = document.getElementById('beneficiario-manual').checked;
			var sel = document.getElementById('beneficiario-select');
			sel.disabled = manual;
			if (manual) { sel.value = ''; }
			BENEF_IDS.forEach(function(id){
				var el = document.getElementById(id);
				el.readOnly = !manual;
				if (manual) el.value = '';
			});
		}

		// Cargar usuarios de la plataforma para el desplegable de beneficiario.
		function loadUsuariosPlataforma() {
			fetch('/api/usuarios')
				.then(function(r) { return r.json(); })
				.then(function(data) {
					if (!data.ok || !data.usuarios) return;
					var bens = document.getElementById('beneficiario-select');
					if (!bens) return;
					bens.innerHTML = '<option value="">-- selecciona un usuario --</option>';
					data.usuarios.forEach(function(u) {
						var opt = document.createElement('option');
						opt.value = JSON.stringify(u);
						opt.textContent = (u.nombre || '') + ' ' + (u.apellido || '') + ' (' + (u.nif || '') + ')';
						bens.appendChild(opt);
					});
				})
				.catch(function(){});
		}

		function fillFromUser(jsonStr, tipo) {
			if (!jsonStr || tipo !== 'beneficiario') return;
			var u;
			try { u = JSON.parse(jsonStr); } catch(e) { return; }
			document.getElementById('beneficiario_nombre').value = u.nombre || '';
			document.getElementById('beneficiario_apellido').value = u.apellido || '';
			document.getElementById('beneficiario_nif').value = u.nif || '';
			// El pago se realiza en la localidad del beneficiario (editable).
			if (u.localidad) document.getElementById('localidad_pago').value = u.localidad;
		}

		// Cargar al inicio
		loadUsuariosPlataforma();
		fetchAndFillEmisor();
		</script>
	}
}
