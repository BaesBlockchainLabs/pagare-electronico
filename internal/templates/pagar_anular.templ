package templates

templ PagarAnular(user *CurrentUser) {
	@Base("Pagar / Anular Pagaré", user) {
		@PageHead("Cierre", "Pagar o anular un pagaré", "Quema el pagaré en blockchain. Quedará inalterable, pero su histórico se conserva íntegro.")
		<div class="card" style="max-width:760px">
			<div class="alert alert-info">
				@Icon("info")
				Esta acción es irreversible: cierra el ciclo de vida del pagaré en blockchain.
			</div>
			<form id="pago-form" onsubmit="return pagarAnular(event)">
				<div class="field">
					<label class="form-label">ID del pagaré *</label>
					<input type="text" id="pag-id" placeholder="ID del asset en blockchain"/>
				</div>
				<div class="field">
					<label class="form-label">Acción *</label>
					<select id="pag-action">
						<option value="PAGO">Pago (pagaré liquidado)</option>
						<option value="ANULACION">Anulación (por acuerdo de las partes)</option>
						<option value="PRESCRIPCION">Prescripción (3 años, art. 48 LCCH)</option>
					</select>
				</div>
				<div class="form-grid">
					<div class="field">
						<label class="form-label">Referencia (opcional)</label>
						<input type="text" id="pag-ref" placeholder="Nº transferencia, recibo…"/>
					</div>
					<div class="field">
						<label class="form-label">Motivo (opcional)</label>
						<input type="text" id="pag-motivo" placeholder="Motivo de la anulación si aplica"/>
					</div>
				</div>
				<p class="desc">La acción la firma tu identidad (usuario logueado). Debes ser el tenedor actual del pagaré; no necesitas introducir claves.</p>
				<div id="pago-error" class="alert alert-error hidden"></div>
				<div id="pago-ok" class="alert alert-success hidden"></div>
				<div class="mt-4">
					<button type="submit" id="pago-btn" class="btn btn-danger">
						@Icon("flame")
						Ejecutar acción
					</button>
				</div>
			</form>
		</div>
		<script>
		var urlId = new URLSearchParams(window.location.search).get('id');
		if (urlId) document.getElementById('pag-id').value = urlId;

		function pagarAnular(e) {
			e.preventDefault();
			var errEl = document.getElementById('pago-error');
			var okEl = document.getElementById('pago-ok');
			var btn = document.getElementById('pago-btn');
			errEl.classList.add('hidden');
			okEl.classList.add('hidden');

			var payload = {
				id: document.getElementById('pag-id').value.trim(),
				metadata: {
					action: document.getElementById('pag-action').value,
					referencia: document.getElementById('pag-ref').value.trim() || undefined,
					motivo: document.getElementById('pag-motivo').value.trim() || undefined
				}
			};
			// El servidor firma con la clave del usuario logueado; no se envía 'from'.

			btn.disabled = true;
			btn.textContent = 'Procesando…';

			fetch('/api/pagares', {
				method: 'DELETE',
				headers: {'Content-Type': 'application/json'},
				body: JSON.stringify(payload)
			})
			.then(function(r) { return r.json(); })
			.then(function(data) {
				btn.disabled = false;
				btn.textContent = 'Ejecutar acción';
				if (data.ok) {
					var action = document.getElementById('pag-action').value;
					okEl.textContent = 'Acción "' + action + '" completada. El pagaré ha sido quemado en blockchain y su histórico se conserva.';
					okEl.classList.remove('hidden');
				} else {
					errEl.textContent = data.msg || 'Error';
					errEl.classList.remove('hidden');
				}
			})
			.catch(function(err) {
				btn.disabled = false;
				btn.textContent = 'Ejecutar acción';
				errEl.textContent = 'Error: ' + err;
				errEl.classList.remove('hidden');
			});
			return false;
		}

		</script>
	}
}
