package templates

// PagaresList renders a server-rendered grid of pagaré document cards.
// Currently unused (the dashboard fetches client-side) but kept in sync with
// the design system so it can be wired to SSR without rework.
templ PagaresList(assets []PagareListItem) {
	if len(assets) == 0 {
		<div class="card empty">
			<div class="icon">
				@Icon("file-plus")
			</div>
			<p>Todavía no has emitido ningún pagaré.</p>
			<a href="/pagares/nuevo" class="btn btn-primary">Emitir el primero</a>
		</div>
	} else {
		<div class="pagares-grid">
			for _, a := range assets {
				<article class="pagare-card">
					@SealIcon("pc-watermark")
					<div class="pc-head">
						<div>
							<div class="pc-label">Pagaré</div>
							<div class="pc-id" title={ a.ID }>{ a.IDShort }</div>
						</div>
						@StatusBadge(a.Estado)
					</div>
					<div class="pc-amount">{ a.Importe }</div>
					<div class="pc-rule"></div>
					<div class="pc-meta">
						<div class="row"><span>Beneficiario</span><span>{ a.Beneficiario }</span></div>
						<div class="row"><span>Vencimiento</span><span>{ a.Vencimiento }</span></div>
						<div class="row"><span>Emitido</span><span>{ a.Fecha }</span></div>
					</div>
					<div class="pc-actions">
						<a href={ templ.SafeURL("/pagares/historico?id=" + a.ID) } class="btn btn-ghost btn-sm">Histórico</a>
						<a href={ templ.SafeURL("/pagares/verificar?network=test&id=" + a.ID) } class="btn btn-gold btn-sm">Verificar</a>
					</div>
				</article>
			}
		</div>
	}
}

type PagareListItem struct {
	ID           string
	IDShort      string
	Beneficiario string
	Importe      string
	Vencimiento  string
	Fecha        string
	Estado       string
}
