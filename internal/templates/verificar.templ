package templates

templ Verificar(id string, network string, user *CurrentUser) {
	@Base("Verificar Pagaré", user) {
		@PageHead("Verificación pública", "Verificar un pagaré", "Comprueba la existencia y el contenido de un pagaré directamente en la blockchain pública.")
		<div class="card">
			<label class="form-label">ID del asset</label>
			<div class="flex-between">
				<input type="text" id="verify-id" value={ id } placeholder="ID del asset" style="flex:1"/>
				<select id="verify-network" style="width:auto">
					if network == "main" {
						<option value="test">Test</option>
						<option value="main" selected>Main</option>
					} else {
						<option value="test" selected>Test</option>
						<option value="main">Main</option>
					}
				</select>
				<button class="btn btn-gold btn-sm" onclick="verifyPagare()">
					@Icon("shield-check")
					Verificar
				</button>
			</div>
			<div id="verify-result" class="mt-6"></div>
		</div>
		<script>
		function badgeHTML(estado) {
			var map = {
				PAGADO:    ['badge-pagado','Pagado'],
				ANULADO:   ['badge-anulado','Anulado'],
				PRESCRITO: ['badge-prescrito','Prescrito'],
				ENDOSADO:  ['badge-endosado','Endosado'],
				CEDIDO:    ['badge-endosado','Cedido'],
				VENCIDO:   ['badge-vencido','Vencido']
			};
			var m = map[estado] || ['badge-activo','Activo'];
			return '<span class="badge ' + m[0] + '"><span class="dot"></span>' + m[1] + '</span>';
		}

		// Firma del contenido: distinta del registro en blockchain. El registro
		// acredita cuándo se grabó y que no se reordenó; la firma acredita que el
		// texto del pagaré es el que firmó el emisor.
		function firmaHTML(ver) {
			if (!ver || !ver.msg) return '';
			var clase, icono;
			if (ver.integro) {
				clase = 'alert-success';
				icono = '<path d="M20 6 9 17l-5-5"></path>';
			} else if (ver.firmado) {
				clase = 'alert-error';
				icono = '<path d="M12 9v4"></path><path d="M12 17h.01"></path><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path>';
			} else {
				clase = 'alert-info';
				icono = '<circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path>';
			}
			var h = '<div class="alert ' + clase + '">' +
				'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + icono + '</svg>' +
				'<span>' + ver.msg;
			if (ver.clave) {
				h += ' <small>· clave del emisor ' + ver.clave.slice(0, 8) + '…' + ver.clave.slice(-6) + '</small>';
			}
			return h + '</span></div>';
		}

		var urlId = new URLSearchParams(window.location.search).get('id') || document.getElementById('verify-id').value;
		if (urlId) {
			document.getElementById('verify-id').value = urlId;
			verifyPagare();
		}
		function verifyPagare() {
			var id = document.getElementById('verify-id').value.trim();
			var network = document.getElementById('verify-network').value;
			if (!id) return;
			document.getElementById('verify-result').innerHTML = '<p class="text-center text-muted" style="padding:32px 0">Verificando…</p>';
			fetch('/api/pagares/public?network=' + network + '&id=' + encodeURIComponent(id))
				.then(function(r) { return r.json(); })
				.then(function(data) {
					var el = document.getElementById('verify-result');
					if (!data.ok) { el.innerHTML = '<div class="alert alert-error">' + (data.msg || 'No encontrado') + '</div>'; return; }
					var a = data.asset || {};
					var d = a.data || {};
					var ben = d.beneficiario || {};
					var ven = d.vencimiento || {};
					var fir = d.firmante || {};
					var dp = fir.direccion_postal || {};
					var estado = d.estado || '';
					if (!estado && ven.tipo !== 'a_la_vista' && ven.fecha && new Date(ven.fecha) < new Date()) {
						estado = 'VENCIDO';
					}
					var impStr = (d.importe != null ? Number(d.importe).toLocaleString('es-ES', {minimumFractionDigits: 2}) : '') + ' ' + (d.moneda || 'EUR');
					var venStr = ven.tipo === 'a_la_vista' ? 'A la vista' : (ven.fecha ? fmtFecha(ven.fecha) : '');

					var ver = a.verificacion || {};

					var h = '<div class="verify-banner">' +
						'<svg class="seal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"></circle><path d="M9.2 9.3 11.1 11.2 14.8 7.3"></path><path d="M8.4 14.1 7 21 l5-2.6 5 2.6 -1.4-6.9"></path></svg>' +
						'<div style="flex:1"><div class="vb-title">Registrado en blockchain</div><div class="vb-sub">Orden cronológico e integridad del registro · red ' + network + '</div></div>' +
						badgeHTML(estado) +
					'</div>';

					h += firmaHTML(ver);

					h += '<div class="card" style="margin-bottom:0">';
					if (d.no_a_la_orden) {
						h += '<div class="alert alert-info" style="margin-top:0"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>Pagaré <strong>"no a la orden"</strong> (art. 14 LCCH): no endosable, solo cesión ordinaria.</div>';
					}
					h += '<div class="field"><label class="form-label">ID del asset</label><div class="key-display">' + (a.id||'') + '</div></div>';
					h += '<div class="detail-grid">';
					h += '<div class="detail-item"><div class="dl">Importe</div><div class="dv big">' + impStr + '</div></div>';
					h += '<div class="detail-item"><div class="dl">Vencimiento</div><div class="dv">' + venStr + '</div></div>';
					h += '<div class="detail-item"><div class="dl">Denominación</div><div class="dv">' + (d.denominacion||'') + '</div></div>';
					h += '<div class="detail-item"><div class="dl">Localidad de pago</div><div class="dv">' + (d.localidad_pago||'') + '</div></div>';
					h += '<div class="detail-item"><div class="dl">Beneficiario</div><div class="dv">' + (ben.nombre||'') + ' ' + (ben.apellido||'') + ' (' + (ben.nif||'') + ')</div></div>';
					var rotFirmante = fir.tipo === 'juridica' ? 'Firmante (sociedad)' : 'Firmante';
					h += '<div class="detail-item"><div class="dl">' + rotFirmante + '</div><div class="dv">' + (fir.nombre||'') + ' (' + (fir.nif||'') + ')</div></div>';
					// Quién firmó por la sociedad y con qué cargo: de ello depende que
					// quede obligada ella y no personalmente quien firmó (art. 9 LCCH).
					if (fir.representante) {
						var rp = fir.representante;
						var repStr = ((rp.nombre||'') + ' ' + (rp.apellido||'')).trim() + ', ' + (rp.cargo||'') + ' (' + (rp.nif||'') + ')';
						h += '<div class="detail-item"><div class="dl">Firmado por poder</div><div class="dv">' + repStr + '</div></div>';
						var poder = [rp.acreditacion, rp.referencia].filter(Boolean).join(' ');
						if (rp.fecha) poder = (poder + ' de ' + fmtFecha(rp.fecha)).trim();
						h += '<div class="detail-item"><div class="dl">Poder acreditado</div><div class="dv">' +
							(poder || 'No consta') + '</div></div>';
					}
					h += '<div class="detail-item"><div class="dl">Localidad de emisión</div><div class="dv">' + (d.localidad_emision||'') + '</div></div>';
					h += '<div class="detail-item"><div class="dl">Fecha de emisión</div><div class="dv">' + (d.fecha_emision ? fmtFecha(d.fecha_emision) : '') + '</div></div>';
					h += '</div>';
					if (dp.direccion) {
						h += '<div class="field mt-6"><label class="form-label">Dirección del firmante</label><div class="dv">' + dp.direccion + ', ' + dp.localidad + ' ' + dp.codigo_postal + ' (' + dp.pais + ')</div></div>';
					}
					if (d.aval) {
						var av = d.aval;
						var avst = av.avalista || {};
						var alcanceStr = av.alcance === 'parcial'
							? ('Parcial · ' + (av.importe_parcial != null ? Number(av.importe_parcial).toLocaleString('es-ES', {minimumFractionDigits: 2}) + ' ' + (d.moneda || 'EUR') : ''))
							: 'Total';
						h += '<div class="pc-rule"></div>';
						h += '<div class="field"><label class="form-label">Aval (arts. 35-37 LCCH)</label></div>';
						h += '<div class="detail-grid">';
						h += '<div class="detail-item"><div class="dl">Avalista</div><div class="dv">' + (avst.nombre||'') + ' ' + (avst.apellido||'') + ' (' + (avst.nif||'') + ')</div></div>';
						h += '<div class="detail-item"><div class="dl">Alcance</div><div class="dv">' + alcanceStr + '</div></div>';
						h += '<div class="detail-item"><div class="dl">Avalado</div><div class="dv">' + (av.avalado || 'El firmante (art. 36)') + '</div></div>';
						h += '</div>';
					}
					h += '<div class="pc-rule"></div>';
					h += '<div class="detail-grid">';
					h += '<div class="detail-item"><div class="dl">Creación en blockchain</div><div class="dv">' + (d.created_at ? fmtFechaHora(d.created_at) : '') + '</div></div>';
					h += '<div class="detail-item"><div class="dl">Propietario actual</div><div class="key-display">' + (d.propietario_actual || d.from || '') + '</div></div>';
					h += '</div>';
					h += '</div>';
					el.innerHTML = h;
				})
				.catch(function(e) { document.getElementById('verify-result').innerHTML = '<div class="alert alert-error">Error: ' + e + '</div>'; });
		}
		</script>
	}
}
